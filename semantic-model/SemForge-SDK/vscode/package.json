    "viewsContainers": {
      "activitybar": [
        {
          "id": "semforge",
          "title": "SemForge",
          "icon": "resources/semforge.svg"
        }
      ]
    },
    "views": {
      "semforge": [
        {
          "id": "semforgeProject",
          "name": "Package",
          "contextualTitle": "SemForge"
        },
        {
