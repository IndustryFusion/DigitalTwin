{
  "name": "semforge",
  "displayName": "SemForge",
  "description": "Semantic modelling for NGSI-LD, OWL and SHACL: validation, coverage and navigation across a SemForge package.",
  "version": "0.2.0",
  "publisher": "industryfusion",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onView:semforgeProject",
    "onView:semforgeConstraints",
    "onView:semforgeShapes",
    "onView:semforgeModel",
    "onView:semforgeKnowledge",
    "workspaceContains:**/shacl.ttl",
    "workspaceContains:**/model-instance.jsonld",
    "onLanguage:turtle"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "turtle",
        "aliases": [
          "Turtle",
          "RDF Turtle"
        ],
        "extensions": [
          ".ttl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sparql",
        "aliases": [
          "SPARQL"
        ],
        "extensions": [
          ".rq",
          ".sparql"
        ],
        "configuration": "./language/sparql.language-configuration.json"
      }
    ],
    "configuration": {
      "title": "SemForge",
      "properties": {
        "semforge.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter with semforge installed. Defaults to ./venv/bin/python inside the SemForge-SDK folder, then to 'python3'."
        },
        "semforge.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the SemForge language server."
        },
        "semforge.trees.detail": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary",
          "enumDescriptions": [
            "One row per attribute, said in the type page's words (\"required · one · → Filter\"); details and edits on the type page.",
            "Every SHACL parameter as its own row, editable in place."
          ],
          "description": "How much the trees show: Entities & Test Cases, and in SemForge Details, Constraints by Type and Knowledge."
        },
        "semforge.trees.click": {
          "type": "string",
          "enum": [
            "page",
            "source"
          ],
          "default": "page",
          "enumDescriptions": [
            "A click opens the row's page (entity type, test case) in one reused tab; the .ttl/.jsonld is a right-click away (\"Open source\").",
            "A click moves the .ttl/.jsonld editor to the row, as before."
          ],
          "description": "What a click on a row in the trees opens: Entities & Test Cases, and in SemForge Details, Constraints by Type and Knowledge."
        }
      }
    },
    "commands": [
      {
        "command": "semforge.selectPackage",
        "title": "Select package",
        "category": "SemForge",
        "icon": "$(package)"
      },
      {
        "command": "semforge.newProject",
        "title": "New project…",
        "icon": "$(file-directory-create)",
        "category": "SemForge"
      },
      {
        "command": "semforge.initPackage",
        "title": "Create a package in this folder",
        "icon": "$(new-folder)",
        "category": "SemForge"
      },
      {
        "command": "semforge.restart",
        "title": "Restart language server",
        "category": "SemForge"
      },
      {
        "command": "semforge.revalidate",
        "title": "Revalidate package",
        "category": "SemForge"
      },
      {
        "command": "semforge.editConstraint",
        "title": "Edit constraint",
        "icon": "$(edit)",
        "category": "SemForge"
      },
      {
        "command": "semforge.removeConstraint",
        "title": "Remove constraint",
        "icon": "$(trash)",
        "category": "SemForge"
      },
      {
        "command": "semforge.refreshTree",
