          "name": "Types",
          "contextualTitle": "SemForge"
        },
        {
          "id": "semforgeShapes",
          "name": "Shapes",
          "contextualTitle": "SemForge"
        },
        {
          "id": "semforgeModel",
          "name": "Instances",
          "contextualTitle": "SemForge"
        },
        {
          "id": "semforgeKnowledge",
          "name": "Vocabulary",
          "contextualTitle": "SemForge"
        }
      ]
    },
