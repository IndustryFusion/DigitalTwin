    "viewsContainers": {
      "activitybar": [
        {
          "id": "semforge",
          "title": "SemForge",
          "icon": "resources/semforge.svg"
        },
        {
          "id": "semforgeDetails",
          "title": "SemForge Details",
          "icon": "resources/semforge-details.svg"
        }
      ]
    },
    "views": {
      "semforge": [
        {
          "id": "semforgeProject",
          "name": "Package",
          "contextualTitle": "SemForge"
        },
        {
          "id": "semforgeModel",
          "name": "Entities & Test Cases",
          "contextualTitle": "SemForge"
        }
      ],
      "semforgeDetails": [
        {
          "id": "semforgeConstraints",
          "name": "Constraints by Type",
          "contextualTitle": "SemForge Details",
          "when": "semforge.details"
        },
        {
          "id": "semforgeShapes",
          "name": "SHACL Shapes as Written",
          "contextualTitle": "SemForge Details",
          "when": "semforge.details"
        },
        {
          "id": "semforgeKnowledge",
          "name": "Knowledge (Ontology)",
          "contextualTitle": "SemForge Details",
          "when": "semforge.details"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "semforge.newEntityType",
          "when": "view == semforgeConstraints",
          "group": "navigation@0"
        },
        {
          "command": "semforge.refreshTree",
          "when": "view == semforgeConstraints",
          "group": "9_refresh@1"
        },
        {
          "command": "semforge.refreshShapes",
          "when": "view == semforgeShapes",
          "group": "9_refresh@1"
        },
        {
          "command": "semforge.newShape",
          "when": "view == semforgeShapes",
          "group": "navigation@1"
        },
        {
          "command": "semforge.refreshModel",
          "when": "view == semforgeModel",
          "group": "9_refresh@1"
        },
        {
          "command": "semforge.newTestCase",
          "when": "view == semforgeModel",
          "group": "navigation@1"
        },
        {
          "command": "semforge.refreshKnowledge",
          "when": "view == semforgeKnowledge",
          "group": "9_refresh@1"
        },
        {
          "command": "semforge.refreshProject",
          "when": "view == semforgeProject",
          "group": "9_refresh@1"
        },
        {
          "command": "semforge.selectPackage",
          "when": "view == semforgeProject",
          "group": "navigation@0"
        },
        {
          "submenu": "semforge.project",
          "when": "view == semforgeProject",
          "group": "navigation@9"
        },
        {
          "command": "semforge.newAttribute",
          "when": "view == semforgeKnowledge",
          "group": "navigation@1"
        },
        {
          "command": "semforge.openHealthPage",
          "when": "view == semforgeProject",
          "group": "1_pages@1"
        },
        {
          "command": "semforge.openPackagePage",
          "when": "view == semforgeProject",
          "group": "1_pages@2"
        },
        {
          "command": "semforge.newVocabularyClass",
          "when": "view == semforgeKnowledge",
          "group": "1_vocabulary@1"
        },
        {
          "command": "semforge.about.project",
          "when": "view == semforgeProject",
          "group": "navigation@8"
        },
        {
          "command": "semforge.about.model",
          "when": "view == semforgeModel",
          "group": "navigation@8"
        },
        {
          "command": "semforge.about.constraints",
          "when": "view == semforgeConstraints",
          "group": "navigation@8"
        },
        {
          "command": "semforge.about.shapes",
          "when": "view == semforgeShapes",
          "group": "navigation@8"
        },
        {
          "command": "semforge.about.knowledge",
          "when": "view == semforgeKnowledge",
          "group": "navigation@8"
        },
        {
          "command": "semforge.showDetails",
          "when": "view == semforgeProject && !semforge.details",
          "group": "navigation@1"
        },
        {
          "command": "semforge.hideDetails",
          "when": "view == semforgeConstraints",
          "group": "9_refresh@9"
        },
        {
          "command": "semforge.hideDetails",
          "when": "view == semforgeShapes",
          "group": "9_refresh@9"
        },
        {
          "command": "semforge.hideDetails",
          "when": "view == semforgeKnowledge",
          "group": "9_refresh@9"
        }
      ],
      "view/item/context": [
        {
          "command": "semforge.openSparqlBench",
          "when": "view == semforgeShapes && viewItem =~ /^(shape|rule)$/",
          "group": "2_row@1"
        },
        {
          "command": "semforge.addSparqlConstraint",
          "when": "view == semforgeShapes && viewItem =~ /^(shape|rule)$/",
          "group": "1_add@3"
        },
        {
          "command": "semforge.editConstraint",
          "when": "view == semforgeConstraints && viewItem == editable",
          "group": "2_row@1"
        },
        {
          "command": "semforge.editConstraint",
          "when": "view == semforgeConstraints && viewItem == editable && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.removeConstraint",
          "when": "view == semforgeConstraints && viewItem == editable",
          "group": "2_row@2"
        },
        {
          "command": "semforge.removeConstraint",
          "when": "view == semforgeConstraints && viewItem == editable && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.addAttributeConstraint",
          "when": "view == semforgeConstraints && viewItem == shape",
          "group": "2_row@3"
        },
        {
          "command": "semforge.addAttributeConstraint",
          "when": "view == semforgeConstraints && viewItem == shape && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.goToDefinition",
          "when": "view == semforgeConstraints && viewItem == inherited",
          "group": "2_row@4"
        },
        {
          "command": "semforge.goToDefinition",
          "when": "view == semforgeConstraints && viewItem == inherited && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.overrideHere",
          "when": "view == semforgeConstraints && viewItem == inherited",
          "group": "2_row@5"
        },
        {
          "command": "semforge.overrideHere",
          "when": "view == semforgeConstraints && viewItem == inherited && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.addAttribute",
          "when": "view == semforgeModel && viewItem == entity",
          "group": "2_row@6"
        },
        {
          "command": "semforge.addAttribute",
          "when": "view == semforgeModel && viewItem == entity && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.addEntity",
          "when": "view == semforgeModel && viewItem == example",
          "group": "2_row@7"
        },
        {
          "command": "semforge.addEntity",
          "when": "view == semforgeModel && viewItem == example && config.semforge.trees.detail == full",
          "group": "inline"
        },
        {
          "command": "semforge.goToShape",
          "when": "view == semforgeModel && viewItem =~ /^(exampleEditable|exampleDataset|exampleSeries|attributeReadOnly)$/",
          "group": "2_row@8"
