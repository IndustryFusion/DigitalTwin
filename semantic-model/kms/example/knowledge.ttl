@prefix iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/> .
@prefix base: <https://industryfusion.github.io/contexts/example/v0/base_knowledge/> .
@prefix iffBindingsBaseTest: <https://industryfusion.github.io/contexts/example/v0/bindings/base_test/> .
@prefix iffFilterEntities: <https://industryfusion.github.io/contexts/example/v0/filter_entities/> .
@prefix iffFilterKnowledge: <https://industryfusion.github.io/contexts/example/v0/filter_knowledge/> .
@prefix material: <https://industryfusion.github.io/contexts/ontology/v0/material/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iffBaseEntities: a owl:Ontology ;
    owl:imports <https://industryfusion.github.io/contexts/staging/ontology/v0.1/ngsild.ttl> ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/example/v0.1/base_entities.ttll> ;
    owl:versionInfo "v0.1"^^xsd:string .

iffBaseEntities:Lasercutter a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf iffBaseEntities:Cutter .

iffBaseEntities:Plasmacutter a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf iffBaseEntities:Cutter .

iffBaseEntities:hasCartridge a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Filter ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Relationship> .

iffBaseEntities:hasFilter a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Cutter ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Relationship> .

iffBaseEntities:hasHeight a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Workpiece ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> ;
    base:boundBy iffBindingsBaseTest:heightBinding .

iffBaseEntities:hasInWorkpiece a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Cutter ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Relationship> .

iffBaseEntities:hasLength a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Workpiece ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> ;
    base:boundBy iffBindingsBaseTest:lengthBinding .

iffBaseEntities:hasMaterial a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Workpiece ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> ;
    base:boundBy iffBindingsBaseTest:materialBinding .

iffBaseEntities:hasOutWorkpiece a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Cutter ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Relationship> .

iffBaseEntities:hasState a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Machine ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> ;
    base:boundBy iffBindingsBaseTest:stateBindingCutter,
        iffBindingsBaseTest:stateBindingFilter .

iffBaseEntities:hasStrength a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Filter ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> ;
    base:boundBy iffBindingsBaseTest:strengthBinding .

iffBaseEntities:hasWidth a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Workpiece ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> .

iffBaseEntities:isUsedFrom a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:FilterCartridge ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> .

iffBaseEntities:isUsedUntil a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:FilterCartridge ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> .

base: a owl:Ontology ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/example/v0.1/base_knowledge.ttl> ;
    owl:versionInfo "0.1"^^xsd:string .

base:FieldType a owl:Class .

base:OPCUAConnector a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf base:BoundConnector .

base:bindingVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .

base:bindsConnector a owl:ObjectProperty ;
    rdfs:domain base:BoundMap ;
    rdfs:range base:BoundConnector .

base:bindsConnectorAttribute a owl:DatatypeProperty .

base:bindsContext a owl:DatatypeProperty ;
    rdfs:range xsd:string .

base:bindsEntityType a owl:ObjectProperty ;
    rdfs:domain base:Binding .

base:bindsFirmware a owl:DatatypeProperty ;
    rdfs:domain base:Binding ;
    rdfs:range xsd:string .

base:bindsLogic a owl:DatatypeProperty ;
    rdfs:domain base:BoundMap ;
    rdfs:range xsd:string .

base:bindsLogicVar a owl:DatatypeProperty ;
    rdfs:domain base:BoundMap ;
    rdfs:range xsd:string .

base:bindsMap a owl:ObjectProperty ;
    rdfs:domain base:Binding ;
    rdfs:range base:BoundMap .

base:bindsMapDataType a owl:ObjectProperty ;
    rdfs:domain base:BoundMap ;
    rdfs:range rdfs:Datatype .

base:boundBy a owl:ObjectProperty ;
    rdfs:domain <https://uri.etsi.org/ngsi-ld/Property>,
        <https://uri.etsi.org/ngsi-ld/Relationship> ;
    rdfs:range base:Binding .

base:hasEntity a owl:AnnotationProperty .

base:isValidFor a owl:ObjectProperty ;
    rdfs:domain base:MachineState .

base:severityCritical a owl:NamedIndividual,
        base:SeverityClass ;
    rdfs:label "critical" .

base:severityWarning a owl:NamedIndividual,
        base:SeverityClass ;
    rdfs:label "warning" .

base:state_CLEANING a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "CLEANING" ;
    base:isValidFor iffBaseEntities:Filter .

base:state_CLEARING a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "CLEARING" ;
    base:isValidFor iffBaseEntities:Cutter .

base:state_ERROR a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "ERROR" ;
    base:isValidFor iffBaseEntities:Machine .

base:state_OFF a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "OFF" ;
    base:isValidFor iffBaseEntities:Machine .

base:state_ON a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "ON" ;
    base:isValidFor iffBaseEntities:Machine .

base:state_PREPARING a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "PREPARING" ;
    base:isValidFor iffBaseEntities:Cutter .

base:state_PROCESSING a owl:NamedIndividual,
        base:MachineState ;
    rdfs:label "PROCESSING" ;
    base:isValidFor iffBaseEntities:Cutter .

iffBindingsBaseTest: a owl:Ontology ;
    owl:imports <https://industryfusion.github.io/contexts/staging/example/v0.1/base_entities.ttl>,
        <https://industryfusion.github.io/contexts/staging/example/v0.1/base_knowledge.ttl> ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/example/v0.1/bindings/base_test.ttl> ;
    owl:versionInfo "0.1"^^xsd:string .

iffBindingsBaseTest:testBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindingVersion "0.9"^^xsd:string ;
    base:bindsConnector base:TestConnector ;
    base:bindsEntityType iffBaseEntities:Filter ;
    base:bindsFirmware "123"^^xsd:string,
        "xyz"^^xsd:string ;
    base:bindsMap iffBindingsBaseTest:_map1 .

iffBindingsBaseTest:widthBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindsEntityType iffBaseEntities:Workpiece ;
    base:bindsFirmware "xyz" ;
    base:bindsMap iffBindingsBaseTest:_map7 .

iffFilterEntities: a owl:Ontology ;
    owl:imports <https://industryfusion.github.io/contexts/staging/example/v0.1/base_entities.ttll>,
        <https://industryfusion.github.io/contexts/staging/example/v0.1/filter_knowledge.ttl>,
        <https://uri.etsi.org/ngsi-ld/> ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/example/v0.1/filter_entities.ttl> ;
    owl:versionInfo "v0.1"^^xsd:string .

iffFilterEntities:hasWasteclass a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:FilterCartridge ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Property> .

iffFilterKnowledge: a owl:Ontology ;
    owl:imports <https://industryfusion.github.io/contexts/staging/ontology/v0.1/material.ttl> ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/example/v0.1/filter_knowledge.ttl> ;
    owl:versionInfo "v0.1"^^xsd:string .

iffFilterKnowledge:hasWasteclass a owl:ObjectProperty ;
    rdfs:domain material:Material ;
    rdfs:range iffFilterKnowledge:Wasteclass .

iffFilterKnowledge:higherHazardLevel a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain iffFilterKnowledge:Wasteclass ;
    rdfs:range iffFilterKnowledge:Wasteclass .

material: a owl:Ontology ;
    owl:versionIRI <https://industryfusion.github.io/contexts/staging/ontology/v0.1/material.ttl> .

material:EN_1.3401 a owl:NamedIndividual,
        material:Material ;
    iffFilterKnowledge:hasWasteclass iffFilterKnowledge:WC1 ;
    material:contains material:_17,
        material:_18,
        material:_19,
        material:_20,
        material:_21,
        material:_22 .

material:EN_1.4301 a owl:NamedIndividual,
        material:Material ;
    iffFilterKnowledge:hasWasteclass iffFilterKnowledge:WC2 ;
    material:contains material:_10,
        material:_11,
        material:_12,
        material:_13,
        material:_14,
        material:_15,
        material:_16,
        material:_9 .

material:EN_1.5301 a owl:NamedIndividual,
        material:Material ;
    iffFilterKnowledge:hasWasteclass iffFilterKnowledge:WC3 ;
    material:contains material:_1,
        material:_2,
        material:_3,
        material:_4,
        material:_5,
        material:_6,
        material:_7,
        material:_8 ;
    material:hasEvaporationTemperature "1200" .

material:contains a owl:ObjectProperty ;
    rdfs:domain material:Material ;
    rdfs:range material:_ElementOccurance .

material:hasChemicalSymbol a owl:DatatypeProperty ;
    rdfs:domain material:ChemicalElement ;
    rdfs:range xsd:string .

material:hasEvaporationTemperature a owl:DatatypeProperty ;
    rdfs:domain material:Material ;
    rdfs:range xsd:string .

material:hasMaxPercent a owl:DatatypeProperty ;
    rdfs:domain material:_ElementOccurance ;
    rdfs:range xsd:string .

material:hasMinPercent a owl:DatatypeProperty ;
    rdfs:domain material:_ElementOccurance ;
    rdfs:range xsd:string .

material:isChemicalElement a owl:ObjectProperty ;
    rdfs:domain material:_ElementOccurance ;
    rdfs:range material:ChemicalElement .

xsd:integer a rdfs:Datatype,
        owl:NamedIndividual .

iffBindingsBaseTest:_map2 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "stateattr2" ;
    base:bindsLogicVar "var2" ;
    base:bindsMapDataType xsd:integer .

iffBindingsBaseTest:_map3 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "heightattr" ;
    base:bindsLogicVar "var3" ;
    base:bindsMapDataType xsd:decimal .

iffBindingsBaseTest:_map4 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnectorAttribute "lengthattr" ;
    base:bindsLogicVar "var4" ;
    base:bindsMapDataType xsd:decimal .

iffBindingsBaseTest:_map5 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "materialattr" ;
    base:bindsLogicVar "var5" ;
    base:bindsMapDataType xsd:string .

iffBindingsBaseTest:_map6 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "strengthattr" ;
    base:bindsLogicVar "var6" ;
    base:bindsMapDataType xsd:decimal .

iffBindingsBaseTest:_map7 a owl:NamedIndividual,
        base:BoundMap ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "widthattr" ;
    base:bindsLogicVar "var7" ;
    base:bindsMapDataType xsd:decimal .

iffBindingsBaseTest:_map8 a owl:NamedIndividual ;
    base:bindsConnector base:TestConnector ;
    base:bindsConnectorAttribute "filterstateattr" ;
    base:bindsLogicVar "var8" ;
    base:bindsMapDataType xsd:boolean .

iffBindingsBaseTest:heightBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindingVersion "0.9"^^xsd:string ;
    base:bindsEntityType iffBaseEntities:Workpiece ;
    base:bindsFirmware "123"^^xsd:string,
        "Firmware xyz" ;
    base:bindsMap iffBindingsBaseTest:_map3 .

iffBindingsBaseTest:lengthBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindsEntityType iffBaseEntities:Workpiece ;
    base:bindsFirmware "xyz" ;
    base:bindsMap iffBindingsBaseTest:_map4 .

iffBindingsBaseTest:materialBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindsEntityType iffBaseEntities:Workpiece ;
    base:bindsFirmware "xyz" ;
    base:bindsMap iffBindingsBaseTest:_map5 .

iffBindingsBaseTest:stateBindingCutter a owl:NamedIndividual,
        base:Binding ;
    base:bindingVersion "0.9"^^xsd:string ;
    base:bindsEntityType iffBaseEntities:Cutter ;
    base:bindsFirmware "abc",
        "xyz" ;
    base:bindsLogic """WHERE  {
    BIND(ngsi-ld:Property as ?type)
    BIND( 
        IF(?var1 = true, 
            IF(FLOOR(?var2/500) = 0, iffBaseKnowledge:state_ON, 
                IF(FLOOR(?var2/500) = 1, iffBaseKnowledge:state_PROCESSING, iffBaseKnowledge:state_ERROR )
            )
            , iffBaseKnowledge:state_OFF
        ) as ?value
    )
    BIND(IF(BOUND(?var1) && BOUND(?var2), 1.0, 0.0) as ?trustLevel)
}""" ;
    base:bindsMap iffBindingsBaseTest:_map1,
        iffBindingsBaseTest:_map2 .

iffBindingsBaseTest:stateBindingFilter a owl:NamedIndividual ;
    base:bindingVersion "0.9"^^xsd:string ;
    base:bindsEntityType iffBaseEntities:Filter ;
    base:bindsFirmware "xyz" ;
    base:bindsLogic """WHERE  {
    BIND(ngsi-ld:Property as ?type)
    BIND( 
        IF(?var8 = true, 
            iffBaseKnowledge:state_ON,
            iffBaseKnowledge:state_OFF
        ) as ?value
    )
    BIND(IF(BOUND(?var8), 1.0, 0.0) as ?trustLevel)
}"""^^xsd:string ;
    base:bindsMap iffBindingsBaseTest:_map8 ;
    base:hasEntity iffBaseEntities:Filter .

iffBindingsBaseTest:strengthBinding a owl:NamedIndividual,
        base:Binding ;
    base:bindingVersion "0.9"^^xsd:string ;
    base:bindsEntityType iffBaseEntities:Filter ;
    base:bindsFirmware "xyz" ;
    base:bindsLogic """WHERE {
    BIND(ngsi-ld:Property as ?type)
    BIND( 
        ?var6 / "10.0"^^xsd:float
         as ?value
    )
    BIND(IF( BOUND(?var6), 1.0, 0.0) as ?trustLevel)
}"""^^xsd:string ;
    base:bindsMap iffBindingsBaseTest:_map6 .

