@prefix : <https://industryfusion.github.io/contexts/example/v0/e2e_shacl/> .
@prefix iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/> .
@prefix ngsild: <https://uri.etsi.org/ngsi-ld/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shapes for the Flink e2e test KMS. Kept as small as possible: every shape
# here is asserted on by test-shacl-flink-e2e.bats, and anything extra would
# only add alerts the test has to filter out.

# --------------------------------------------------------------- minCount
# An E2EMachine must carry hasE2EState. An entity published with no attributes
# at all therefore alerts immediately, and the alert must be RETRACTED once the
# attribute arrives. That covers the whole compiled pipeline in both
# directions, which is the part a unit test cannot reach.
:E2EMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2EState ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:order 1 ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:nodeKind sh:Literal ] ] .

# --------------------------------------------------------------- sh:xone
# Exactly one of the two ranges must hold. The branches are disjoint, so a
# value in between satisfies NEITHER and the constraint is violated -- a case
# no sh:or can express, which makes this a genuine test of the circuit
# evaluation rather than of the leaf checks.
#
# sh:minCount sits BESIDE the sh:xone on purpose. Those parameters are
# conjoined with the connective, not a member of it, and they used to be lost
# silently -- so this shape pins both halves: the count must be enforced
# independently AND the xone truth table must stay two-branched.
:E2ERangeMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2ERangeMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2ERange ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:order 1 ;
            sh:xone (
                [ sh:property [ sh:path ngsild:hasValue ;
                        sh:nodeKind sh:Literal ;
                        sh:minInclusive 100 ] ]
                [ sh:property [ sh:path ngsild:hasValue ;
                        sh:nodeKind sh:Literal ;
                        sh:maxInclusive 10 ] ]
            ) ] .

# --------------------------------------------------------- deletion
# An E2ELinkedMachine must link to exactly one cartridge, and that cartridge
# must exist. Both parameters are load-bearing for the deletion tests:
#
#   sh:minCount/sh:maxCount is the aggregate that was reported reading
#   "Found -1 relationships instead of [1, 1]" -- a value it cannot produce
#   unless the count applied more retractions than accumulations, which is what
#   deleting an entity used to do to it.
#
#   sh:class is the check that fires when the entity on the FAR END of the
#   relationship is the one deleted. Nothing about the linking entity changes
#   in that case, so no other shape here can reach it.
:E2ELinkedMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2ELinkedMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2ECartridge ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:order 1 ;
            sh:property [ sh:path ngsild:hasObject ;
                    sh:class iffBaseEntities:E2ECartridge ] ;
            sh:property [ sh:path rdf:type ;
                    sh:hasValue ngsild:Relationship ;
                    sh:minCount 1 ] ] .

# iffBaseEntities:E2EFreeMachine is deliberately NOT targeted by any shape.

# ------------------------------------------------- knowledge-backed state
# Declares hasE2EKnownState so the SPARQL translator can resolve it: a property
# named only in an sh:sparql query and nowhere in the shapes is rejected with
# "Unexpected property structure". The value is an IRI because the constraint
# below looks it up in the knowledge, which a literal could never match.
:E2EKnowledgeMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EKnowledgeMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2EKnownState ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:order 1 ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:nodeKind sh:IRI ] ] .

# --------------------------------------------------------------- sh:sparql
# The production KMS carries four sh:sparql constraints and this KMS carried
# none, so no e2e test ever ran one against Flink -- they were exercised only
# offline against the SQLite oracle. That is a blind spot with teeth: a SPARQL
# constraint reaches the knowledge through the `rdf` table, and in Flink that
# is join STATE rather than a table that is simply there, so it can expire and
# take the constraint's answers with it while the oracle keeps agreeing with
# itself.
#
# rdfs:subClassOf* is what makes this a knowledge query rather than an
# attribute one: E2ESpecialMachine is a subclass of E2EKnowledgeMachine, so a
# state valid for the parent must remain valid for the child, and answering
# that requires the rdf join to still be there.
:E2EStateValueShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraints ;
            sh:message "State value {?value} is not valid for {$this} of type {?type}" ;
            sh:select """
PREFIX iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>

SELECT $this ?value ?type
        where {
             ?this a ?type .
             ?this iffBaseEntities:hasE2EKnownState [ ngsild:hasValue ?value ] .
           FILTER NOT EXISTS{
                ?value iffBaseEntities:isValidForE2E ?subtype .
                ?type rdfs:subClassOf* ?subtype .
            }
        }
        """ ] ;
    sh:targetClass iffBaseEntities:E2EKnowledgeMachine .

# --------------------------------------------------------------- sh:datatype
# Numbers as JSON-LD 1.1 types them (#958): a plain number is a double only
# with a non-zero fractional part, 80.0 included is an integer, a declared
# @type decides, and a string is judged by its text. On Flink every value has
# been through the debezium bridge, which writes 80.0 as 80 even when it is
# declared a double -- the part the SQLite checks cannot show.
:E2ENumberMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2ENumberMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2EDouble ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:datatype xsd:double ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2EInteger ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:datatype xsd:integer ;
                    sh:nodeKind sh:Literal ] ] ,
        # Without sh:nodeKind (#1097) the datatype is checked all the same, an
        # sh:or of datatypes too; a Relationship has no value to check.
        [ sh:path iffBaseEntities:hasE2EBareDouble ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:datatype xsd:double ] ] ,
        [ sh:path iffBaseEntities:hasE2EBareNumber ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:or ( [ sh:datatype xsd:double ] [ sh:datatype xsd:integer ] ) ] ] ,
        [ sh:path iffBaseEntities:hasE2EBareString ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:datatype xsd:string ] ] ,
        # A datatype the check reads by its text with one it reads by its type.
        [ sh:path iffBaseEntities:hasE2EBareDecimal ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ] ] .

# ------------------------------------------------ sh:datatype beside others
# Without sh:nodeKind, a datatype beside and inside connectives (#1097): judged
# for each instance, and the connectives keep their verdicts. Rows of the
# constraint table only: the statements are the same with and without them.
:E2EDatatypeMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EDatatypeMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2EPlain ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ] ] ,
        [ sh:path iffBaseEntities:hasE2ENotFive ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ;
                    sh:not [ sh:hasValue 5 ] ] ] ,
        [ sh:path iffBaseEntities:hasE2EEither ;
            sh:or ( [ sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:integer ] ]
                    [ sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ] ] ) ] ,
        [ sh:path iffBaseEntities:hasE2EBoth ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:and ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] ) ] ] ,
        [ sh:path iffBaseEntities:hasE2EOpen ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ] ] ,
        [ sh:path iffBaseEntities:hasE2EText ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:string ] ] ,
        [ sh:path iffBaseEntities:hasE2EKind ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2EAnyText ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] ] ,
        [ sh:path iffBaseEntities:hasE2EFlag ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:boolean ] ] ,
        [ sh:path iffBaseEntities:hasE2EOff ;
            sh:deactivated true ;
            sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ] ] .

# ------------------------------------------------------- sh:hasValue a number
# A number required by sh:hasValue is compared as a number (#965): 80, 80.0
# and a declared double 80 equal both 80.0 (an xsd:decimal) and 80. The bridge
# writes a plain 80.0 as 80 with no type, which a comparison of the texts
# rejected on Flink while SQLite accepted it. A declared integer 80 does not
# equal 80.5 (SQLite used to truncate the constant to 80), and a string
# constant "1.0" is compared as text, so the string "1" does not equal it.
:E2EHasValueMachineShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EHasValueMachine ;
    sh:property [ sh:path iffBaseEntities:hasE2EDecimalValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue 80.0 ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2EIntegerValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue 80 ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2EFractionValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue 80.5 ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2EStringValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue "1.0" ;
                    sh:nodeKind sh:Literal ] ] ,
        # A string constant is compared with the text the platform sends
        # (#1044): the bridge writes a plain 1, 1.0 and a declared double 1 as
        # 1, so they meet "1" and not "1.0". A boolean constant is met by the
        # same boolean (#1045): plain true, a declared xsd:boolean 1 and the
        # string "true", not "True", the string "1" or the number 1.
        [ sh:path iffBaseEntities:hasE2EOneText ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue "1" ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2ETrueValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue true ;
                    sh:nodeKind sh:Literal ] ] ,
        # A constant of another datatype is compared like a string constant
        # (#1044): plain 2020, "2020" and a declared xsd:gYear 2020 meet it.
        # "NaN" is no text the platform sends for a number: 0 violates it.
        [ sh:path iffBaseEntities:hasE2EYearValue ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue "2020"^^xsd:gYear ;
                    sh:nodeKind sh:Literal ] ] ,
        [ sh:path iffBaseEntities:hasE2ENaNText ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:hasValue "NaN" ;
                    sh:nodeKind sh:Literal ] ] .

# ------------------------------------------- node shape on a relationship's object
# The members an instance declaration adds to a child of a generic type (openspec
# gh-985-instance-declaration-shapes): the owner's hasE2EPart applies a node shape
# to the entity it refers to. E2EPart itself has no shape -- the requirement comes
# from the owner's declaration, so the alert belongs to the OWNER, one per
# relationship instance (NodeConstraintComponent(hasE2EPart[<datasetId>])), and
# follows the part's attributes, the part's deletion and the relationship.
# hasE2EPart has no count, so a placeholder with several datasetIds is allowed.
:E2EOwnerShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EOwner ;
    sh:property [ sh:path iffBaseEntities:hasE2EPart ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasObject ;
                    sh:class iffBaseEntities:E2EPart ;
                    sh:node :E2EOwner_PartDeclarationShape ] ] .

# No target of its own: it applies where an E2EOwner's hasE2EPart refers to an entity.
:E2EOwner_PartDeclarationShape a sh:NodeShape ;
    sh:property [ sh:path iffBaseEntities:hasE2ELevel ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasValue ;
                    sh:nodeKind sh:Literal ;
                    sh:datatype xsd:double ] ] .

# --------------------------------------------- what a SPARQL query may look like
# Forms of shacl2flink/sparql-expressions (#1107) on a real Flink: an attribute
# only a shape without a target declares, a variable predicate, numbers without
# a cast, an OPTIONAL first, and an attribute read outside and inside a
# NOT EXISTS. Each constraint has a shape of its own, so that its alert names it.
:E2EQueryDeclarationShape a sh:NodeShape ;
    sh:property [ sh:path iffBaseEntities:hasE2ESpare ;
            sh:nodeKind sh:BlankNode ;
            sh:property [ sh:path ngsild:hasObject ;
                    sh:nodeKind sh:IRI ] ] .

:E2EQueryDeclaredShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EQueryMachine ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Declared" ;
            sh:select """
PREFIX e: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>
SELECT $this WHERE {
    $this e:hasE2ESpare [ ngsild:hasObject ?o ] .
}
""" ] .

:E2EQueryAnyAttributeShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EQueryMachine ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "AnyAttribute" ;
            sh:select """
PREFIX e: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>
SELECT $this WHERE {
    $this ?attribute [ ngsild:hasValue ?v ] .
    FILTER(?attribute NOT IN (e:hasE2EUpper, e:hasE2ELower) && ?v = "forbidden")
}
""" ] .

:E2EQueryNumbersShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EQueryMachine ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Numbers" ;
            sh:select """
PREFIX e: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>
SELECT $this WHERE {
    $this e:hasE2EUpper [ ngsild:hasValue ?u ] .
    $this e:hasE2ELower [ ngsild:hasValue ?l ] .
    FILTER(?l > ?u)
}
""" ] .

:E2EQueryOptionalFirstShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EQueryMachine ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "OptionalFirst" ;
            sh:select """
PREFIX e: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>
SELECT $this WHERE {
    OPTIONAL { $this e:hasE2ELower [ ngsild:hasValue ?l ] }
    $this e:hasE2EUpper [ ngsild:hasValue ?u ] .
    FILTER(bound(?l) && ?l >= 100)
}
""" ] .

:E2EQuerySameAttributeShape a sh:NodeShape ;
    sh:targetClass iffBaseEntities:E2EQueryMachine ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "SameAttribute" ;
            sh:select """
PREFIX e: <https://industryfusion.github.io/contexts/example/v0/base_entities/>
PREFIX ngsild: <https://uri.etsi.org/ngsi-ld/>
SELECT $this WHERE {
    $this e:hasE2EUpper [ ngsild:hasValue ?u ] .
    FILTER NOT EXISTS { $this e:hasE2EUpper [ ngsild:hasValue ?w ] . FILTER(?w < 50) }
}
""" ] .
