@prefix iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/> .
@prefix ngsild: <https://uri.etsi.org/ngsi-ld/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# sh:datatype without sh:nodeKind next to other constraints (#1097). What is
# checked is what every instance has to meet on its own; a connective gives the
# verdict it gave before, so no instance that conforms raises an alert.

<https://industryfusion.github.io/contexts/example/v0/base_shacl/DatatypeBesideConnectivesShape> a sh:NodeShape ;
    sh:targetClass iffBaseEntities:Filter ;
    sh:property [ sh:path iffBaseEntities:hasOuterOr ;
        sh:or ( [ sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:integer ] ] [ sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ] ] ) ] ,
    [ sh:path iffBaseEntities:hasBoundedOr ;
        sh:property [ sh:path ngsild:hasValue ; sh:or ( [ sh:datatype xsd:integer ; sh:minInclusive 0 ] [ sh:datatype xsd:double ] ) ] ] ,
    [ sh:path iffBaseEntities:hasNotFive ;
        sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:double ; sh:not [ sh:hasValue 5 ] ] ] ,
    [ sh:path iffBaseEntities:hasNotBad ;
        sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:string ; sh:not [ sh:pattern "^bad" ] ] ] ,
    [ sh:path iffBaseEntities:hasDecimal ;
        sh:property [ sh:path ngsild:hasValue ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ] ] ,
    [ sh:path iffBaseEntities:hasAnyText ;
        sh:property [ sh:path ngsild:hasValue ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString> ] ) ] ] ,
    [ sh:path iffBaseEntities:hasElement ;
        sh:property [ sh:path ngsild:hasValue ; sh:property [ sh:path ( [ sh:zeroOrMorePath <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> ] <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ) ; sh:datatype xsd:integer ] ] ] ,
    [ sh:path iffBaseEntities:hasTextOrOther ;
        sh:property [ sh:path ngsild:hasValue ; sh:or ( [ sh:datatype xsd:string ] [ sh:property [ sh:path iffBaseEntities:hasOther ; sh:maxCount 1 ] ] ) ] ] ,
    [ sh:path iffBaseEntities:hasText ;
        sh:property [ sh:path ngsild:hasValue ; sh:datatype xsd:string ] ] ,
    [ sh:path iffBaseEntities:hasBoth ;
        sh:property [ sh:path ngsild:hasValue ; sh:and ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] ) ] ] .
