@prefix ex: <https://example.org/subclass/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A chain of classes as the OPC UA knowledge writes it: a node is typed with
# its most specific class, uacore:Object, and sh:class asks for uacore:Node.
ex:Node a owl:Class .
ex:Instance a owl:Class ; rdfs:subClassOf ex:Node .
ex:Object a owl:Class ; rdfs:subClassOf ex:Instance .
ex:Other a owl:Class .
ex:EventEnumeration a owl:Class ; rdfs:subClassOf ex:Node .

ex:executing a ex:Object .
ex:stopped a ex:Node .
ex:both a ex:Other, ex:Object .
ex:unrelated a ex:Other .
ex:PARAMETER_CHANGE a ex:EventEnumeration .
