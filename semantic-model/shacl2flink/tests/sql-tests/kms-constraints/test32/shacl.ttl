@prefix iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/> .
@prefix ngsild: <https://uri.etsi.org/ngsi-ld/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# A relationship whose sh:class names a type that no shape targets (#1113).
# The offline model has to hold the referenced entity anyway, as the platform
# does, or every link to it is reported as not linked.

<https://industryfusion.github.io/contexts/example/v0/base_shacl/MachineShape> a sh:NodeShape ;
    sh:targetClass iffBaseEntities:Machine ;
    sh:property [ sh:path iffBaseEntities:hasFolder ;
        sh:property [ sh:path ngsild:hasObject ; sh:class iffBaseEntities:Folder ] ] .
