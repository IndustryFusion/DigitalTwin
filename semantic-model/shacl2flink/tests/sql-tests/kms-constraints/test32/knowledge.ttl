@prefix iffBaseEntities: <https://industryfusion.github.io/contexts/example/v0/base_entities/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

iffBaseEntities:Machine a owl:Class .
iffBaseEntities:Folder a owl:Class .
iffBaseEntities:SubFolder a owl:Class ; rdfs:subClassOf iffBaseEntities:Folder .
iffBaseEntities:Other a owl:Class .

iffBaseEntities:hasFolder a owl:ObjectProperty ;
    rdfs:domain iffBaseEntities:Machine ;
    rdfs:range <https://uri.etsi.org/ngsi-ld/Relationship> .
