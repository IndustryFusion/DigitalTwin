@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Main shape for OPC UA nodes (Properties and Variables)
base:OPCUAModellingRuleShape a sh:NodeShape ;
    sh:targetClass uardf:Object, uardf:ObjectType, uardf:Variable, uardf:VariableType, uardf:Method, uardf:DataType, uardf:ReferenceType, uardf:View;

    # hasValueRank is optional; if absent, default to -1.
    sh:property [
        sh:path opcua:HasModellingRule ;
        sh:in (opcua:aT03OA opcua:aT04MA opcua:aT0xMTUwOA opcua:aT0xMTUxMA opcua:aT04Mw) ;  # i=78 i=80 i=11508 i=11510 i=83
        sh:maxCount 1 ;
        sh:message "hasModellingRule must reference a modelling rule node and shall appear at most once."
    ] ;


    # SPARQL constraint: ModellingRule only for Object, Variable or Method
    sh:sparql [
        sh:message "The node {$this} should not have a ModellingRule." ;
        sh:select """
          PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
          PREFIX opcua: <http://opcfoundation.org/UA/>
          PREFIX uardf: <http://opcfoundation.org/rdf/uacore#>
          PREFIX owl: <http://www.w3.org/2002/07/owl#>
          PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
          PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
          PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

          SELECT $this WHERE {
            $this opcua:HasModellingRule ?ml .
            # Only an Object, a Variable or a Method may carry a ModellingRule.
            # Test the node's node class -- comparing $this itself against a class
            # IRI can never hold, so the node class has to be bound and filtered.
            FILTER NOT EXISTS {
              $this rdf:type ?nodeClass .
              FILTER(?nodeClass = uardf:Object
                     || ?nodeClass = uardf:Variable
                     || ?nodeClass = uardf:Method)
            }
          }
        """ ;
    ] ;
.