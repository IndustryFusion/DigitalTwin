@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# KNOWN GAP (not implemented here): OPC UA Part 3 §6.4.4.2 requires that when a subtype
# overrides an InstanceDeclaration (or reuses another type's instance as its own
# InstanceDeclaration, per §6.4.4.3), its ModellingRule may only be a *narrowing* of the
# original -- Mandatory stays Mandatory; Optional may become Mandatory or stay Optional;
# MandatoryPlaceholder stays MandatoryPlaceholder; OptionalPlaceholder may become
# MandatoryPlaceholder or stay OptionalPlaceholder. Loosening (e.g. Mandatory->Optional)
# is never permitted ("constraints shall only be tightened, not loosened").
#
# The shape below only checks hasModellingRule's cardinality (<=1) and that its value is
# one of the 5 known ModellingRule nodes -- it does NOT compare a node's ModellingRule
# against the one on the InstanceDeclaration it overrides/derives from, so an illegal
# loosening is not currently caught. See docs/validation-rules-part3.md, rule AS-046, for
# the full rule statement, spec citations, and rationale. This is the same shape of
# problem as the ValueRank-narrowing check below in rankValue.shacl.ttl (which *is*
# implemented) -- would need supertype/seed lookup logic that doesn't exist here yet.

# Main shape for OPC UA nodes (Properties and Variables)
base:OPCUAModellingRuleShape a sh:NodeShape ;
    sh:targetClass opcua:BaseNodeClass;

    # hasValueRank is optional; if absent, default to -1.
    sh:property [
        sh:path base:hasModellingRule ;
        sh:in (opcua:nodei78 opcua:nodei80 opcua:nodei11508 opcua:nodei11510 opcua:nodei83) ;
        sh:maxCount 1 ;
        sh:message "hasModellingRule must reference a modelling rule node and shall appear at most once."
    ] ;


    # SPARQL constraint: ModellingRule only for Object, Variable or Method
    sh:sparql [
        sh:message "The node {$this} should not have a ModellingRule." ;
        sh:select """
          PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
          PREFIX opcua: <http://opcfoundation.org/UA/>
          PREFIX owl: <http://www.w3.org/2002/07/owl#>
          PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
          PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
          PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

          SELECT $this WHERE { 
            $this base:hasModellingRule ?ml .
              FILTER($this != opcua:ObjectNodeClass && $this && opcua:VariableNodeClass && $this != opcua:MethodNodeClass)
          }
        """ ;
    ] ;
.