@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Main shape for OPC UA nodes (Properties and Variables)
base:OPCUAHasPropertyRuleShape a sh:NodeShape ;
    sh:targetClass uardf:Object, uardf:ObjectType, uardf:Variable, uardf:VariableType, uardf:Method, uardf:DataType, uardf:ReferenceType, uardf:View;

    sh:property [
        sh:path opcua:HasProperty ;
        sh:class uardf:Variable ;
        sh:nodeKind sh:IRI ;
        sh:message "HasProperty must reference a Variable."
    ] ;

    sh:property [
        sh:path ( opcua:HasProperty uardf:hasTypeDefinition ) ;
        sh:in ( opcua:PropertyType ) ;
        sh:message "HasProperty must reference a Variable of PropertyType."
    ] ;

.
base:NoHasPropertyOnVariableNodeShape a sh:NodeShape ;
    sh:targetObjectsOf opcua:HasProperty ;
    sh:property [
         sh:path opcua:HasProperty ;
         sh:maxCount 0 ;
         sh:message "A variable node (referenced via HasProperty) must not have its own HasProperty links." ;
    ] .