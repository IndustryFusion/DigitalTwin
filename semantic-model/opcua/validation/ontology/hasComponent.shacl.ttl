@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

base:HasComponentVariableTypeConstraint a sh:NodeShape ;
    sh:targetClass uardf:Variable ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Variable node {$this} reached by HasComponent reference must be (or inherit from) opcua:BaseDataVariableType." ;
        sh:select """
            PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
            PREFIX opcua: <http://opcfoundation.org/UA/>
            PREFIX uardf: <http://opcfoundation.org/rdf/uacore#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                # Ensure that $this is reached by a hasComponent relation:
                ?source  opcua:HasComponent $this.
                # Now check for the proper type. Only report what the graph proves: the
                # TypeDefinition is known to be (a subtype of) BaseVariableType or PropertyType,
                # but not of BaseDataVariableType. A type whose hierarchy is not loaded (e.g.
                # a core VariableType when validating with -ni) is not reported.
                $this uardf:hasTypeDefinition|rdf:type ?t .
                ?t rdfs:subClassOf* ?root .
                FILTER(?root = opcua:BaseVariableType || ?root = opcua:PropertyType)
                FILTER NOT EXISTS {
                    ?t rdfs:subClassOf* opcua:BaseDataVariableType .
                }
            }
        """ ;
    ] .

base:VariableComponentDependencyShape a sh:NodeShape ;
    sh:targetClass uardf:Variable ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The Variable has a HasComponent reference to another Variable, but is not a DataVariable because it lacks an incoming HasComponent reference." ;
        sh:select """
            PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
             PREFIX opcua: <http://opcfoundation.org/UA/>
             PREFIX uardf: <http://opcfoundation.org/rdf/uacore#>
             PREFIX owl: <http://www.w3.org/2002/07/owl#>
             PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
             PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
             PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
            WHERE {
                # $this is the Variable node A.
                # Check if A has an outgoing hasComponent to a variable node B.
                $this opcua:HasComponent ?component .
                ?component rdf:type uardf:Variable .
                # If A is not referenced by any other node via hasComponent, then it is not a DataVariable.
                FILTER NOT EXISTS { ?parent opcua:HasComponent $this . }
}
        """
    ] .



base:HasComponentTargetConstraint a sh:NodeShape ;
    sh:targetClass uardf:Object, uardf:ObjectType, uardf:Variable, uardf:VariableType, uardf:Method, uardf:DataType, uardf:ReferenceType, uardf:View ;
    sh:sparql [
         a sh:SPARQLConstraint ;
         sh:message "A node reached via HasComponent must be a Variable, Object, or Method." ;
         sh:select """
            PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
             PREFIX opcua: <http://opcfoundation.org/UA/>
             PREFIX uardf: <http://opcfoundation.org/rdf/uacore#>
             PREFIX owl: <http://www.w3.org/2002/07/owl#>
             PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
             PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
             PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
             SELECT $this
           WHERE {
             # Consider only nodes reached via HasComponent.
             $this ^opcua:HasComponent ?source .
             $this a ?type .
             FILTER(STRSTARTS(STR(?type), STR(uardf:)))
             FILTER(?type != uardf:Variable && ?type != uardf:Object && ?type != uardf:Method)
           }
         """
    ] .

base:HasComponentTargetSourceConstraint a sh:NodeShape ;
    sh:targetClass uardf:Variable ;
    sh:targetClass uardf:Object ;
    sh:targetClass uardf:Method ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a HasComponent reference from {$source} to {$this}: if the target is a Variable then its source must be an Object, ObjectType, DataVariable or VariableType; if the target is an Object or a Method then its source must be an Object or ObjectType." ;
        sh:select """
            PREFIX base: <https://industryfusion.github.io/contexts/ontology/v0/base/>
            PREFIX opcua: <http://opcfoundation.org/UA/>
            PREFIX uardf: <http://opcfoundation.org/rdf/uacore#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
             SELECT $this ?source ?stype
            WHERE {
  				$this a uardf:Variable .
                # Find the source node that points to this target via hasComponent.
                #$this ^opcua:HasComponent ?source .
                {
    				 $this ^opcua:HasComponent ?source .
                    # Case 1: The target is a Variable.
                    $this a uardf:Variable .
    				?source a ?stype .
    				FILTER(STRSTARTS(STR(?stype), STR(uardf:)))
    				OPTIONAL{?grand_source opcua:HasComponent ?source}
      				FILTER(?stype != uardf:Object && 
      					   ?stype != uardf:ObjectType && 
      						(?stype != uardf:Variable || !bound(?grand_source)) && 
                           ?stype != uardf:VariableType)
                }
  				UNION {
     				$this ^opcua:HasComponent ?source .
                        # Case 2: The target is an Object or a Method.
                    $this a ?t .
                    FILTER(?t = uardf:Object || ?t = uardf:Method) .
                        ?source a ?stype .
    				?source a ?stype .
    				FILTER(STRSTARTS(STR(?stype), STR(uardf:)))
      				FILTER(?stype != uardf:Object && ?stype != uardf:ObjectType )
    				
            	}
            }
        """
    ] .