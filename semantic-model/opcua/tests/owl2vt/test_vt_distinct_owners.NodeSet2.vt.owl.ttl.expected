@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sb: <https://industryfusion.github.io/contexts/ontology/v0/semanticbridge/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://my.test/> a owl:Ontology ;
    owl:imports <file:///home/marcel/src/DigitalTwin/semantic-model/opcua/core.vt.owl.ttl>,
        rdf:,
        rdfs:,
        <https://industryfusion.github.io/contexts/staging/ontology/v0.3/base.ttl>,
        <https://industryfusion.github.io/contexts/staging/ontology/v0/ngsild.ttl> ;
    owl:versionIRI <http://example.com/v0.1/test/> ;
    owl:versionInfo 1e-01 .

<http://my.test/MiniMachineType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/SubMachineAType> ;
            owl:onProperty <http://my.test/hasSubStateA> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/SubMachineAType> ;
            owl:onProperty <http://my.test/hasSubStateA> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/SubMachineBType> ;
            owl:onProperty <http://my.test/hasSubStateB> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_6eea88f316afe2afc2bde8e7> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_6eea88f316afe2afc2bde8e7> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/SubMachineBType> ;
            owl:onProperty <http://my.test/hasSubStateB> ],
        opcua:BaseObjectType .

opcua:ValueRank_MoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions .

opcua:ValueRank_OneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions,
        opcua:ValueRank_ScalarOrOneDimension .

<http://my.test/VT_6eea88f316afe2afc2bde8e7> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom opcua:String ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:String ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_Scalar ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_Scalar ;
            owl:onProperty sb:hasValueRank ],
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/CurrentState" .

<http://my.test/VT_f21bf6f17863b27ce4bd05b0> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_Scalar ;
            owl:onProperty sb:hasValueRank ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_Scalar ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:Int32 ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom opcua:Int32 ],
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/CurrentState" .

<http://my.test/VT_f931e187f8e2ac1724c9802e> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_Scalar ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:String ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_Scalar ;
            owl:onProperty sb:hasValueRank ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom opcua:String ],
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/CurrentState" .

<http://my.test/hasSubStateA> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

<http://my.test/hasSubStateB> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

opcua:ValueRank_Any a owl:Class .

opcua:ValueRank_OneOrMoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

opcua:ValueRank_ScalarOrOneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

<http://my.test/SubMachineAType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_f931e187f8e2ac1724c9802e> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_f931e187f8e2ac1724c9802e> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        opcua:BaseObjectType .

<http://my.test/SubMachineBType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_f21bf6f17863b27ce4bd05b0> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_f21bf6f17863b27ce4bd05b0> ;
            owl:onProperty <http://my.test/hasCurrentState> ],
        opcua:BaseObjectType .

base:SemanticBridgeReferenceType a owl:ObjectProperty .

<http://my.test/hasCurrentState> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

sb:hasDataType a owl:FunctionalProperty,
        owl:ObjectProperty .

sb:hasValueRank a owl:FunctionalProperty,
        owl:ObjectProperty .

opcua:ValueRank_Scalar a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_ScalarOrOneDimension .

[] a owl:AllDisjointClasses ;
    owl:members ( opcua:ValueRank_Scalar opcua:ValueRank_OneDimension opcua:ValueRank_MoreDimensions ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://my.test/MiniMachineType> <http://my.test/SubMachineAType> <http://my.test/SubMachineBType> opcua:AggregateConfigurationType opcua:AggregateFunctionType opcua:AlarmMetricsType opcua:AliasNameType opcua:AuthorizationServiceConfigurationType opcua:BaseConditionClassType opcua:BaseEventType opcua:BaseInterfaceType opcua:CertificateGroupType opcua:CertificateType opcua:ConnectionTransportType opcua:DataSetReaderMessageType opcua:DataSetReaderTransportType opcua:DataSetReaderType opcua:DataSetWriterMessageType opcua:DataSetWriterTransportType opcua:DataSetWriterType opcua:DataTypeEncodingType opcua:DataTypeSystemType opcua:DictionaryEntryType opcua:ExtensionFieldsType opcua:FileType opcua:FolderType opcua:HistoricalDataConfigurationType opcua:HistoricalEventConfigurationType opcua:HistoricalExternalEventSourceType opcua:HistoryServerCapabilitiesType opcua:IetfBaseNetworkInterfaceType opcua:KeyCredentialConfigurationType opcua:ModellingRuleType opcua:NamespaceMetadataType opcua:NamespacesType opcua:NetworkAddressType opcua:OrderedListType opcua:PriorityMappingTableType opcua:ProvisionableDeviceType opcua:PubSubCapabilitiesType opcua:PubSubConnectionType opcua:PubSubDiagnosticsType opcua:PubSubGroupType opcua:PubSubKeyPushTargetType opcua:PubSubKeyServiceType opcua:PubSubStatusType opcua:PublishedDataSetType opcua:QuantityType opcua:ReaderGroupMessageType opcua:ReaderGroupTransportType opcua:RoleSetType opcua:RoleType opcua:SecurityGroupType opcua:ServerCapabilitiesType opcua:ServerConfigurationType opcua:ServerDiagnosticsType opcua:ServerRedundancyType opcua:ServerType opcua:SessionDiagnosticsObjectType opcua:SessionsDiagnosticsSummaryType opcua:StandaloneSubscribedDataSetType opcua:StateMachineType opcua:StateType opcua:SubscribedDataSetType opcua:TemporaryFileTransferType opcua:TransactionDiagnosticsType opcua:TransitionType opcua:UnitType opcua:UserManagementType opcua:VendorServerInfoType opcua:WriterGroupMessageType opcua:WriterGroupTransportType ) .

