@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sb: <https://industryfusion.github.io/contexts/ontology/v0/semanticbridge/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://my.test/> a owl:Ontology ;
    owl:imports <file:///home/marcel/src/DigitalTwin/semantic-model/opcua/core.vt.owl.ttl>,
        rdf:,
        rdfs:,
        <https://industryfusion.github.io/contexts/staging/ontology/v0.3/base.ttl>,
        <https://industryfusion.github.io/contexts/staging/ontology/v0/ngsild.ttl> ;
    owl:versionIRI <http://example.com/v0.1/test/> ;
    owl:versionInfo 1e-01 .

<http://my.test/SubType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_ba2a0c29e16ec7e465fcc8c3> ;
            owl:onProperty <http://my.test/hasCode> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_ba2a0c29e16ec7e465fcc8c3> ;
            owl:onProperty <http://my.test/hasCode> ],
        <http://my.test/BaseType> .

opcua:ValueRank_MoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions .

opcua:ValueRank_OneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions,
        opcua:ValueRank_ScalarOrOneDimension .

base:SemanticBridgeReferenceType a owl:ObjectProperty .

<http://my.test/BaseType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_28951feba74e0688d6fd985a> ;
            owl:onProperty <http://my.test/hasCode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_28951feba74e0688d6fd985a> ;
            owl:onProperty <http://my.test/hasCode> ],
        opcua:BaseObjectType .

<http://my.test/SpecificCodeType> a owl:Class ;
    rdfs:subClassOf <http://my.test/GenericCodeType> .

<http://my.test/VT_ba2a0c29e16ec7e465fcc8c3> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_Scalar ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_Scalar ;
            owl:onProperty sb:hasValueRank ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/SpecificCodeType> ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom <http://my.test/SpecificCodeType> ],
        <http://my.test/VT_28951feba74e0688d6fd985a>,
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/Code" .

opcua:ValueRank_Any a owl:Class .

opcua:ValueRank_OneOrMoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

opcua:ValueRank_ScalarOrOneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

<http://my.test/VT_28951feba74e0688d6fd985a> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/GenericCodeType> ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_Scalar ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom <http://my.test/GenericCodeType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_Scalar ;
            owl:onProperty sb:hasValueRank ],
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/Code" .

<http://my.test/GenericCodeType> a owl:Class ;
    rdfs:subClassOf opcua:Enumeration .

<http://my.test/hasCode> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

sb:hasDataType a owl:FunctionalProperty,
        owl:ObjectProperty .

sb:hasValueRank a owl:FunctionalProperty,
        owl:ObjectProperty .

opcua:ValueRank_Scalar a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_ScalarOrOneDimension .

[] a owl:AllDisjointClasses ;
    owl:members ( opcua:ValueRank_Scalar opcua:ValueRank_OneDimension opcua:ValueRank_MoreDimensions ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://my.test/BaseType> opcua:AggregateConfigurationType opcua:AggregateFunctionType opcua:AlarmMetricsType opcua:AliasNameType opcua:AuthorizationServiceConfigurationType opcua:BaseConditionClassType opcua:BaseEventType opcua:BaseInterfaceType opcua:CertificateGroupType opcua:CertificateType opcua:ConnectionTransportType opcua:DataSetReaderMessageType opcua:DataSetReaderTransportType opcua:DataSetReaderType opcua:DataSetWriterMessageType opcua:DataSetWriterTransportType opcua:DataSetWriterType opcua:DataTypeEncodingType opcua:DataTypeSystemType opcua:DictionaryEntryType opcua:ExtensionFieldsType opcua:FileType opcua:FolderType opcua:HistoricalDataConfigurationType opcua:HistoricalEventConfigurationType opcua:HistoricalExternalEventSourceType opcua:HistoryServerCapabilitiesType opcua:IetfBaseNetworkInterfaceType opcua:KeyCredentialConfigurationType opcua:ModellingRuleType opcua:NamespaceMetadataType opcua:NamespacesType opcua:NetworkAddressType opcua:OrderedListType opcua:PriorityMappingTableType opcua:ProvisionableDeviceType opcua:PubSubCapabilitiesType opcua:PubSubConnectionType opcua:PubSubDiagnosticsType opcua:PubSubGroupType opcua:PubSubKeyPushTargetType opcua:PubSubKeyServiceType opcua:PubSubStatusType opcua:PublishedDataSetType opcua:QuantityType opcua:ReaderGroupMessageType opcua:ReaderGroupTransportType opcua:RoleSetType opcua:RoleType opcua:SecurityGroupType opcua:ServerCapabilitiesType opcua:ServerConfigurationType opcua:ServerDiagnosticsType opcua:ServerRedundancyType opcua:ServerType opcua:SessionDiagnosticsObjectType opcua:SessionsDiagnosticsSummaryType opcua:StandaloneSubscribedDataSetType opcua:StateMachineType opcua:StateType opcua:SubscribedDataSetType opcua:TemporaryFileTransferType opcua:TransactionDiagnosticsType opcua:TransitionType opcua:UnitType opcua:UserManagementType opcua:VendorServerInfoType opcua:WriterGroupMessageType opcua:WriterGroupTransportType ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://my.test/GenericCodeType> opcua:ApplicationType opcua:AxisScaleEnumeration opcua:BrokerTransportQualityOfService opcua:ConversionLimitEnum opcua:DataSetOrderingType opcua:DiagnosticsLevel opcua:Duplex opcua:ExceptionDeviationFormat opcua:FilterOperator opcua:HistoryUpdateType opcua:IdType opcua:IdentityCriteriaType opcua:InterfaceAdminStatus opcua:InterfaceOperStatus opcua:MessageSecurityMode opcua:NamingRuleType opcua:NegotiationStatus opcua:NodeAttributesMask opcua:NodeClass opcua:OpenFileMode opcua:OverrideValueHandling opcua:PerformUpdateType opcua:PubSubDiagnosticsCounterClassification opcua:PubSubState opcua:RedundancySupport opcua:RedundantServerMode opcua:SecurityTokenRequestType opcua:ServerState opcua:StructureType opcua:TrustListMasks opcua:TsnFailureCode opcua:TsnListenerStatus opcua:TsnStreamState opcua:TsnTalkerStatus opcua:UserTokenType ) .

