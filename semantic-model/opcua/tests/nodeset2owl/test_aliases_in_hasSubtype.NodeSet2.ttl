@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix test: <http://example.org/MinimalNodeset/> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test: a owl:Ontology ;
    owl:versionIRI <http://example.com/v0.1/UA/> ;
    owl:versionInfo 1e-01 .

test:TESTNamespace a base:Namespace ;
    base:hasPrefix "test" ;
    base:hasUri "http://example.org/MinimalNodeset/" .

test:bnN1PWh0dHA6Ly9leGFtcGxlLm9yZy9NaW5pbWFsTm9kZXNldDtpPTEwMDE a uardf:ObjectType ;
    uardf:browseName "nsu=http://example.org/MinimalNodeset;ObjectType" ;
    uardf:definesType test:ObjectType ;
    uardf:description "A custom Object Type"@en ;
    uardf:displayName "ObjectType"@en ;
    uardf:name "ObjectType" ;
    uardf:namespaceUri "http://example.org/MinimalNodeset" ;
    uardf:nodeId "nsu=http://example.org/MinimalNodeset;i=1001" ;
    uardf:symbolicName "ObjectType" .

test:ObjectType a owl:Class ;
    rdfs:subClassOf opcua:BaseObjectType .

