@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

opcua: a owl:Ontology ;
    owl:versionIRI <http://example.com/v0.1/UA/> ;
    owl:versionInfo 1e-01 .

opcua:OPCUANamespace a base:Namespace ;
    base:hasPrefix "opcua" ;
    base:hasUri "http://opcfoundation.org/UA/" .

opcua:aT00NA a uardf:ReferenceType ;
    uardf:browseName "Aggregates" ;
    uardf:definesType opcua:Aggregates ;
    uardf:displayName "Aggregates"@en ;
    uardf:isAbstract true ;
    uardf:name "Aggregates" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=44" ;
    uardf:symbolicName "Aggregates" .

opcua:aT00Nw a uardf:ReferenceType ;
    uardf:browseName "HasComponent" ;
    uardf:definesType opcua:HasComponent ;
    uardf:displayName "HasComponent"@en ;
    uardf:name "HasComponent" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=47" ;
    uardf:symbolicName "HasComponent" .

opcua:aT01OA a uardf:ObjectType ;
    uardf:browseName "BaseObjectType" ;
    uardf:definesType opcua:BaseObjectType ;
    uardf:displayName "BaseObjectType"@en ;
    uardf:name "BaseObjectType" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=58" ;
    uardf:symbolicName "BaseObjectType" .

opcua:aT02Mg a uardf:VariableType ;
    uardf:browseName "BaseVariableType" ;
    uardf:definesType opcua:BaseVariableType ;
    uardf:displayName "BaseVariableType"@en ;
    uardf:isAbstract true ;
    uardf:name "BaseVariableType" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=62" ;
    uardf:symbolicName "BaseVariableType" ;
    base:hasValueRank -2 .

opcua:aT0yNA a uardf:DataType ;
    uardf:browseName "BaseDataType" ;
    uardf:definesType opcua:BaseDataType ;
    uardf:displayName "BaseDataType"@en ;
    uardf:isAbstract true ;
    uardf:name "BaseDataType" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=24" ;
    uardf:symbolicName "BaseDataType" .

opcua:aT0yNg a uardf:DataType ;
    uardf:browseName "Number" ;
    uardf:definesType opcua:Number ;
    uardf:displayName "Number"@en ;
    uardf:isAbstract true ;
    uardf:name "Number" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=26" ;
    uardf:symbolicName "Number" .

opcua:aT0zMQ a uardf:ReferenceType ;
    uardf:browseName "References" ;
    uardf:definesType opcua:References ;
    uardf:displayName "References"@en ;
    uardf:isAbstract true ;
    uardf:name "References" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=31" ;
    uardf:symbolicName "References" ;
    base:isSymmetric "true" .

opcua:aT0zMg a uardf:ReferenceType ;
    uardf:browseName "NonHierarchicalReferences" ;
    uardf:definesType opcua:NonHierarchicalReferences ;
    uardf:displayName "NonHierarchicalReferences"@en ;
    uardf:isAbstract true ;
    uardf:name "NonHierarchicalReferences" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=32" ;
    uardf:symbolicName "NonHierarchicalReferences" ;
    base:isSymmetric "true" .

opcua:aT0zMw a uardf:ReferenceType ;
    uardf:browseName "HierarchicalReferences" ;
    uardf:definesType opcua:HierarchicalReferences ;
    uardf:displayName "HierarchicalReferences"@en ;
    uardf:isAbstract true ;
    uardf:name "HierarchicalReferences" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=33" ;
    uardf:symbolicName "HierarchicalReferences" .

opcua:aT0zNA a uardf:ReferenceType ;
    uardf:browseName "HasChild" ;
    uardf:definesType opcua:HasChild ;
    uardf:displayName "HasChild"@en ;
    uardf:isAbstract true ;
    uardf:name "HasChild" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/" ;
    uardf:nodeId "i=34" ;
    uardf:symbolicName "HasChild" .

opcua:BaseObjectType a owl:Class .

opcua:BaseVariableType a owl:Class .

opcua:HasComponent a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:Aggregates .

opcua:NonHierarchicalReferences a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:References .

opcua:Number a owl:Class ;
    rdfs:subClassOf opcua:BaseDataType .

opcua:Aggregates a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:HasChild .

opcua:BaseDataType a owl:Class .

opcua:HasChild a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:HierarchicalReferences .

opcua:HierarchicalReferences a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:References .

opcua:References a owl:ObjectProperty .

