    base:hasValueList ( "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 0, \"xsd:DisplayName\": {\"xsd:Text\": \"NoFailure\"}, \"xsd:Description\": {\"xsd:Text\": \"No failure\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 1, \"xsd:DisplayName\": {\"xsd:Text\": \"InsufficientBandwidth\"}, \"xsd:Description\": {\"xsd:Text\": \"Insufficient bandwidth\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 2, \"xsd:DisplayName\": {\"xsd:Text\": \"InsufficientResources\"}, \"xsd:Description\": {\"xsd:Text\": \"Insufficient bridge resources\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 3, \"xsd:DisplayName\": {\"xsd:Text\": \"InsufficientTrafficClassBandwidth\"}, \"xsd:Description\": {\"xsd:Text\": \"Insufficient bandwidth for Traffic Class\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 4, \"xsd:DisplayName\": {\"xsd:Text\": \"StreamIdInUse\"}, \"xsd:Description\": {\"xsd:Text\": \"StreamID in use by another Talker\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 5, \"xsd:DisplayName\": {\"xsd:Text\": \"StreamDestinationAddressInUse\"}, \"xsd:Description\": {\"xsd:Text\": \"Stream destination address already in use\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 6, \"xsd:DisplayName\": {\"xsd:Text\": \"StreamPreemptedByHigherRank\"}, \"xsd:Description\": {\"xsd:Text\": \"Stream pre-empted by higher rank\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 7, \"xsd:DisplayName\": {\"xsd:Text\": \"LatencyHasChanged\"}, \"xsd:Description\": {\"xsd:Text\": \"Reported latency has changed\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 8, \"xsd:DisplayName\": {\"xsd:Text\": \"EgressPortNotAvbCapable\"}, \"xsd:Description\": {\"xsd:Text\": \"Egress port is not AVBCapable\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 9, \"xsd:DisplayName\": {\"xsd:Text\": \"UseDifferentDestinationAddress\"}, \"xsd:Description\": {\"xsd:Text\": \"Use a different destination address\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 10, \"xsd:DisplayName\": {\"xsd:Text\": \"OutOfMsrpResources\"}, \"xsd:Description\": {\"xsd:Text\": \"Out of MSRP resources\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 11, \"xsd:DisplayName\": {\"xsd:Text\": \"OutOfMmrpResources\"}, \"xsd:Description\": {\"xsd:Text\": \"Out of MMRP resources\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 12, \"xsd:DisplayName\": {\"xsd:Text\": \"CannotStoreDestinationAddress\"}, \"xsd:Description\": {\"xsd:Text\": \"Cannot store destination address\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 13, \"xsd:DisplayName\": {\"xsd:Text\": \"PriorityIsNotAnSrcClass\"}, \"xsd:Description\": {\"xsd:Text\": \"Requested priority is not an SR Class priority\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 14, \"xsd:DisplayName\": {\"xsd:Text\": \"MaxFrameSizeTooLarge\"}, \"xsd:Description\": {\"xsd:Text\": \"MaxFrameSize is too large for media\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 15, \"xsd:DisplayName\": {\"xsd:Text\": \"MaxFanInPortsLimitReached\"}, \"xsd:Description\": {\"xsd:Text\": \"MaxFanInPorts limit has been reached\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 16, \"xsd:DisplayName\": {\"xsd:Text\": \"FirstValueChangedForStreamId\"}, \"xsd:Description\": {\"xsd:Text\": \"Changes in FirstValue for a registered StreamID\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 17, \"xsd:DisplayName\": {\"xsd:Text\": \"VlanBlockedOnEgress\"}, \"xsd:Description\": {\"xsd:Text\": \"VLAN is blocked on this egress port (Registration Forbidden)\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 18, \"xsd:DisplayName\": {\"xsd:Text\": \"VlanTaggingDisabledOnEgress\"}, \"xsd:Description\": {\"xsd:Text\": \"VLAN tagging is disabled on this egress port (untagged set)\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 19, \"xsd:DisplayName\": {\"xsd:Text\": \"SrClassPriorityMismatch\"}, \"xsd:Description\": {\"xsd:Text\": \"SR class priority mismatch\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 20, \"xsd:DisplayName\": {\"xsd:Text\": \"FeatureNotPropagated\"}, \"xsd:Description\": {\"xsd:Text\": \"Enhanced feature cannot be propagated to original Port\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 21, \"xsd:DisplayName\": {\"xsd:Text\": \"MaxLatencyExceeded\"}, \"xsd:Description\": {\"xsd:Text\": \"MaxLatency exceeded\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 22, \"xsd:DisplayName\": {\"xsd:Text\": \"BridgeDoesNotProvideNetworkId\"}, \"xsd:Description\": {\"xsd:Text\": \"Nearest Bridge cannot provide network identification for stream transformation\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 23, \"xsd:DisplayName\": {\"xsd:Text\": \"StreamTransformNotSupported\"}, \"xsd:Description\": {\"xsd:Text\": \"Stream transformation not supported\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 24, \"xsd:DisplayName\": {\"xsd:Text\": \"StreamIdTypeNotSupported\"}, \"xsd:Description\": {\"xsd:Text\": \"Stream identification type not supported for stream transformation\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 25, \"xsd:DisplayName\": {\"xsd:Text\": \"FeatureNotSupported\"}, \"xsd:Description\": {\"xsd:Text\": \"Enhanced feature cannot be supported without a CNC\"}}}}"^^rdf:JSON ) ;
