    base:hasValueList ( "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 1, \"xsd:DisplayName\": {\"xsd:Text\": \"UserName\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies a UserName from a UserNameIdentityToken.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 2, \"xsd:DisplayName\": {\"xsd:Text\": \"Thumbprint\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies the Thumbprint of a user or CA Certificate.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 3, \"xsd:DisplayName\": {\"xsd:Text\": \"Role\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule is a Role specified in an Access Token.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 4, \"xsd:DisplayName\": {\"xsd:Text\": \"GroupId\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule is a user group specified in the Access Token.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 5, \"xsd:DisplayName\": {\"xsd:Text\": \"Anonymous\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies Anonymous UserIdentityToken.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 6, \"xsd:DisplayName\": {\"xsd:Text\": \"AuthenticatedUser\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies any non Anonymous UserIdentityToken.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 7, \"xsd:DisplayName\": {\"xsd:Text\": \"Application\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies the combination of an application identity and an Anonymous UserIdentityToken.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 8, \"xsd:DisplayName\": {\"xsd:Text\": \"X509Subject\"}, \"xsd:Description\": {\"xsd:Text\": \"The rule specifies the X509 subject name of a user or CA Certificate.\"}}}}"^^rdf:JSON ) ;
