    base:hasValueList ( "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 0, \"xsd:DisplayName\": {\"xsd:Text\": \"Disabled\"}, \"xsd:Description\": {\"xsd:Text\": \"The related TSN Stream is currently disabled.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 1, \"xsd:DisplayName\": {\"xsd:Text\": \"Configuring\"}, \"xsd:Description\": {\"xsd:Text\": \"The related TSN Stream is in the process of receiving configuration parameters from the TSN Control Layer.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 2, \"xsd:DisplayName\": {\"xsd:Text\": \"Ready\"}, \"xsd:Description\": {\"xsd:Text\": \"The related TSN Stream has successfully received and applied the configuration from the TSN Control Layer. The related TSN Stream is not fully operational as long as local preconditions (e.g. synchronization state) are not valid.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 3, \"xsd:DisplayName\": {\"xsd:Text\": \"Operational\"}, \"xsd:Description\": {\"xsd:Text\": \"The related TSN Stream object is configured and all other required preconditions (e.g. synchronization state) for sending / receiving data are valid.\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 4, \"xsd:DisplayName\": {\"xsd:Text\": \"Error\"}, \"xsd:Description\": {\"xsd:Text\": \"The related TSN Stream object is in an error state.\"}}}}"^^rdf:JSON ) ;
    base:hasValueRank 1 .

