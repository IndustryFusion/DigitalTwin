sd:bnN1PWh0dHA6Ly90ZXN0L1N0YXRpY0R5bmFtaWMvO2k9OTAwMQ a uardf:Variable ;
    uardf:browseName "NamespaceUri" ;
    uardf:displayName "NamespaceUri"@en ;
