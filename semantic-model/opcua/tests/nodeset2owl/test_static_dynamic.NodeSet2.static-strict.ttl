sd:bnN1PWh0dHA6Ly90ZXN0L1N0YXRpY0R5bmFtaWMvO2k9MTAwMg a uardf:Variable ;
    opcua:HasModellingRule opcua:aT03OA ;
    uardf:browseName "nsu=http://test/StaticDynamic/;Temperature" ;
    uardf:displayName "Temperature"@en ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Temperature" ;
    uardf:namespaceUri "http://test/StaticDynamic/" ;
    uardf:nodeId "nsu=http://test/StaticDynamic/;i=1002" ;
