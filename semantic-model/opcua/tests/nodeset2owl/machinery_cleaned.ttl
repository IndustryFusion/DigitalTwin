machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9NjA3OQ a uardf:Variable ;
    opcua:HasModellingRule opcua:aT04MA ;
    uardf:browseName "nsu=http://opcfoundation.org/UA/DI/;PowerOnDuration" ;
    uardf:description "PowerOnDuration is the duration the MachineryItem has been powered. The main purpose is to determine the time in which degradation of the MachineryItem occurred. The details, when the time is counted, is implementation-specific. Companion specifications might define specific rules. Typically, when the MachineryItem has supply voltage and the main CPU is running, the time is counted. This may include any kind of sleep mode, but may not include pure Wake on LAN. This value shall only increase during the lifetime of the MachineryItem and shall not be reset when it is restarted. The PowerOnDuration is provided as Duration, i.e., in milliseconds or even fractions of a millisecond. However, the Server is not expected to update the value in such a high frequency, but maybe once a minute or once an hour, depending on the application."@en ;
    uardf:displayName "PowerOnDuration"@en ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "PowerOnDuration" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/Machinery/" ;
    uardf:nodeId "nsu=http://opcfoundation.org/UA/Machinery/;i=6079" ;
    uardf:parent machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9MTAwOQ ;
    uardf:symbolicName "PowerOnDuration" ;
    base:hasAccessLevel opcua:CurrentRead,
        opcua:CurrentWrite ;
    base:hasDatatype opcua:Duration .

machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9NjA4MA a uardf:Variable ;
    opcua:HasModellingRule opcua:aT04MA ;
    uardf:browseName "nsu=http://opcfoundation.org/UA/DI/;OperationDuration" ;
    uardf:description "OperationDuration is the duration the MachineryItem has been powered and performing an activity. This counter is intended for machines and components where a distinction is made between switched on and in operation. For example, a drive might be powered on but not operating. It is not intended for machines or components always performing an activity like sensors always measuring data. This value shall only increase during the lifetime of the MachineryItem and shall not be reset when it is restarted. The OperationDuration is provided as Duration, i.e., in milliseconds or even fractions of a millisecond. However, the Server is not expected to update the value in such a high frequency, but maybe once a minute or once an hour, depending on the application."@en ;
    uardf:displayName "OperationDuration"@en ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "OperationDuration" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/Machinery/" ;
    uardf:nodeId "nsu=http://opcfoundation.org/UA/Machinery/;i=6080" ;
    uardf:parent machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9MTAwOQ ;
    uardf:symbolicName "OperationDuration" ;
    base:hasAccessLevel opcua:CurrentRead,
        opcua:CurrentWrite ;
    base:hasDatatype opcua:Duration .

machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9NjA4MQ a uardf:Variable ;
    opcua:HasModellingRule opcua:aT04MA ;
    uardf:browseName "nsu=http://opcfoundation.org/UA/DI/;OperationCycleCounter" ;
    uardf:description "OperationCycleCounter is counting the times the component switches from not performing an activity to performing an activity. For example, each time a valve starts moving, is counted. This value shall only increase during the lifetime of the component and shall not be reset when the component is restarted."@en ;
    uardf:displayName "OperationCycleCounter"@en ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "OperationCycleCounter" ;
    uardf:namespaceUri "http://opcfoundation.org/UA/Machinery/" ;
    uardf:nodeId "nsu=http://opcfoundation.org/UA/Machinery/;i=6081" ;
    uardf:parent machinery:bnN1PWh0dHA6Ly9vcGNmb3VuZGF0aW9uLm9yZy9VQS9NYWNoaW5lcnkvO2k9MTAwOQ ;
    uardf:symbolicName "OperationCycleCounter" ;
    base:hasAccessLevel opcua:CurrentRead,
        opcua:CurrentWrite ;
    base:hasDatatype opcua:UInteger .

