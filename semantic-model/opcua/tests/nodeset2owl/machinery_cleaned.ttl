    uardf:browseName "nsu=http://opcfoundation.org/UA/DI/;SoftwareRevision" ;
    uardf:description "A string representation of the revision level of a MachineryItem. In most cases, MachineryItems consist of several software components. In that case, information about the software components might be provided as additional information in the address space, including individual revision information. In that case, this property is either not provided or provides an overall software revision level. The value might change during the life-cycle of a MachineryItem."@en ;
    uardf:displayName "SoftwareRevision"@en ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "SoftwareRevision" ;
