    base:hasValueList ( "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 0, \"xsd:DisplayName\": {\"xsd:Text\": \"Level1\"}, \"xsd:Description\": {\"xsd:Text\": \"Level 1 is characterized by simple actions carried out with minimal training\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 1, \"xsd:DisplayName\": {\"xsd:Text\": \"Level2\"}, \"xsd:Description\": {\"xsd:Text\": \"Level 2 is characterized by basic actions which have to be carried out by qualified personnel using detailed procedures \"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 2, \"xsd:DisplayName\": {\"xsd:Text\": \"Level3\"}, \"xsd:Description\": {\"xsd:Text\": \"Level 3 is characterized by complex actions carried out by qualified technical personnel using detailed procedures\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 3, \"xsd:DisplayName\": {\"xsd:Text\": \"Level4\"}, \"xsd:Description\": {\"xsd:Text\": \"Level 4 is characterized by actions which imply the know-how of a technique or a technology and carried out by specialized technical personnel\"}}}}"^^rdf:JSON "{\"xsd:TypeId\": {\"xsd:Identifier\": \"i=7616\"}, \"xsd:Body\": {\"xsd:EnumValueType\": {\"xsd:Value\": 4, \"xsd:DisplayName\": {\"xsd:Text\": \"Level5\"}, \"xsd:Description\": {\"xsd:Text\": \"Level 5 is characterized by actions which imply a knowledge held by the manufacturer or a specialized company with industrial logistic support equipment\"}}}}"^^rdf:JSON ) ;
    base:hasValueRank 1 .

