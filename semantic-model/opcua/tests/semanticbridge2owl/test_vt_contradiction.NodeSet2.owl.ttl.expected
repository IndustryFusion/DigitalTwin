@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sb: <https://industryfusion.github.io/contexts/ontology/v0/semanticbridge/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://my.test/> a owl:Ontology ;
    owl:imports <file:///home/marcel/src/DigitalTwin/semantic-model/opcua/core.owl.ttl>,
        rdf:,
        rdfs:,
        <https://industryfusion.github.io/contexts/staging/ontology/v0.3/base.ttl>,
        <https://industryfusion.github.io/contexts/staging/ontology/v0/ngsild.ttl> ;
    owl:versionIRI <http://example.com/v0.1/test/> ;
    owl:versionInfo 1e-01 .

<http://my.test/SubType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_785e8afd2dbfb8041e9beca4> ;
            owl:onProperty <http://my.test/hasSignal> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_785e8afd2dbfb8041e9beca4> ;
            owl:onProperty <http://my.test/hasSignal> ],
        <http://my.test/BaseType> .

<http://my.test/BaseType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_0d94b86d0fb80fa6be1b3122> ;
            owl:onProperty <http://my.test/hasSignal> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_0d94b86d0fb80fa6be1b3122> ;
            owl:onProperty <http://my.test/hasSignal> ],
        opcua:BaseObjectType .

opcua:ValueRank_Scalar a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_ScalarOrOneDimension .

base:SemanticBridgeReferenceType a owl:ObjectProperty .

<http://my.test/VT_785e8afd2dbfb8041e9beca4> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom opcua:Double ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_MoreDimensions ;
            owl:onProperty sb:hasValueRank ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_MoreDimensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:Double ;
            owl:onProperty sb:hasDataType ],
        <http://my.test/VT_0d94b86d0fb80fa6be1b3122>,
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/Signal" .

opcua:ValueRank_Any a owl:Class .

opcua:ValueRank_OneOrMoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

opcua:ValueRank_ScalarOrOneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

<http://my.test/VT_0d94b86d0fb80fa6be1b3122> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:ValueRank_OneDimension ;
            owl:onProperty sb:hasValueRank ],
        [ a owl:Restriction ;
            owl:allValuesFrom opcua:Double ;
            owl:onProperty sb:hasDataType ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasDataType ;
            owl:someValuesFrom opcua:Double ],
        [ a owl:Restriction ;
            owl:onProperty sb:hasValueRank ;
            owl:someValuesFrom opcua:ValueRank_OneDimension ],
        opcua:PropertyType ;
    sb:originalBrowsePath "http://my.test/Signal" .

opcua:ValueRank_MoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions .

opcua:ValueRank_OneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions,
        opcua:ValueRank_ScalarOrOneDimension .

<http://my.test/hasSignal> a owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

sb:hasDataType a owl:FunctionalProperty,
        owl:ObjectProperty .

sb:hasValueRank a owl:FunctionalProperty,
        owl:ObjectProperty .

[] a owl:AllDisjointClasses ;
    owl:members ( opcua:ValueRank_Scalar opcua:ValueRank_OneDimension opcua:ValueRank_MoreDimensions ) .

