@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sb: <https://industryfusion.github.io/contexts/ontology/v0/semanticbridge/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://my.test/> a owl:Ontology ;
    owl:imports <file:///home/marcel/src/DigitalTwin/semantic-model/opcua/core.owl.ttl>,
        rdf:,
        rdfs:,
        <https://industryfusion.github.io/contexts/staging/ontology/v0/base.ttl>,
        <https://industryfusion.github.io/contexts/staging/ontology/v0/ngsild.ttl> ;
    owl:versionIRI <http://example.com/v0.1/test/> ;
    owl:versionInfo 1e-01 .

<http://my.test/PumpType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_cd22efb4e232893ce3e5b034> ;
            owl:onProperty <http://my.test/hasDrive> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_cd22efb4e232893ce3e5b034> ;
            owl:onProperty <http://my.test/hasDrive> ],
        opcua:BaseObjectType .

<http://my.test/DriveType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_6e3168eba35ed41ebfbd7e14> ;
            owl:onProperty <http://my.test/hasMotor> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_6e3168eba35ed41ebfbd7e14> ;
            owl:onProperty <http://my.test/hasMotor> ],
        opcua:BaseObjectType .

<http://my.test/VT_273f66d08d244b1f321bfdda> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Double ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_Scalar ;
    sb:originalBrowsePath "http://my.test/Motor/http://my.test/Temperature" .

<http://my.test/VT_4f5bff7f174326377fa63ffb> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Double ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_Scalar ;
    sb:originalBrowsePath "http://my.test/Temperature" .

<http://my.test/VT_945e6a5d5fcde5c4201b37ff> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Double ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_Scalar ;
    sb:originalBrowsePath "http://my.test/Drive/http://my.test/Motor/http://my.test/Temperature" .

opcua:ValueRank_MoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions .

<http://my.test/MotorType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_0d9b5c6ec65404a374532517> ;
            owl:onProperty <http://my.test/hasReadings> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_0d9b5c6ec65404a374532517> ;
            owl:onProperty <http://my.test/hasReadings> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_4f5bff7f174326377fa63ffb> ;
            owl:onProperty <http://my.test/hasTemperature> ],
        opcua:BaseObjectType .

<http://my.test/VT_0d9b5c6ec65404a374532517> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Int32 ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_OneDimension ;
    sb:originalBrowsePath "http://my.test/Readings" .

<http://my.test/VT_372e3d46e5a4a281568cf6b3> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Int32 ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_OneDimension ;
    sb:originalBrowsePath "http://my.test/Drive/http://my.test/Motor/http://my.test/Readings" .

<http://my.test/VT_5503206a1c5dd32c5177040b> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_372e3d46e5a4a281568cf6b3> ;
            owl:onProperty <http://my.test/hasReadings> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_945e6a5d5fcde5c4201b37ff> ;
            owl:onProperty <http://my.test/hasTemperature> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_372e3d46e5a4a281568cf6b3> ;
            owl:onProperty <http://my.test/hasReadings> ],
        <http://my.test/MotorType> ;
    sb:originalBrowsePath "http://my.test/Drive/http://my.test/Motor" .

<http://my.test/VT_6e3168eba35ed41ebfbd7e14> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_273f66d08d244b1f321bfdda> ;
            owl:onProperty <http://my.test/hasTemperature> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_767d4fb24b76c9ca8fbe7e84> ;
            owl:onProperty <http://my.test/hasReadings> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_767d4fb24b76c9ca8fbe7e84> ;
            owl:onProperty <http://my.test/hasReadings> ],
        <http://my.test/MotorType> ;
    sb:originalBrowsePath "http://my.test/Motor" .

<http://my.test/VT_767d4fb24b76c9ca8fbe7e84> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opcua:Int32 ;
            owl:onProperty sb:hasDataType ],
        opcua:PropertyType,
        opcua:ValueRank_OneDimension ;
    sb:originalBrowsePath "http://my.test/Motor/http://my.test/Readings" .

<http://my.test/VT_cd22efb4e232893ce3e5b034> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://my.test/VT_5503206a1c5dd32c5177040b> ;
            owl:onProperty <http://my.test/hasMotor> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://my.test/VT_5503206a1c5dd32c5177040b> ;
            owl:onProperty <http://my.test/hasMotor> ],
        <http://my.test/DriveType> ;
    sb:originalBrowsePath "http://my.test/Drive" .

<http://my.test/hasDrive> a owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

opcua:ValueRank_Any a owl:Class .

opcua:ValueRank_OneOrMoreDimensions a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

opcua:ValueRank_ScalarOrOneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_Any .

<http://my.test/hasTemperature> a owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

<http://my.test/hasMotor> a owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

opcua:ValueRank_OneDimension a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_OneOrMoreDimensions,
        opcua:ValueRank_ScalarOrOneDimension .

opcua:ValueRank_Scalar a owl:Class ;
    rdfs:subClassOf opcua:ValueRank_ScalarOrOneDimension .

base:SemanticBridgeReferenceType a owl:ObjectProperty .

<http://my.test/hasReadings> a owl:ObjectProperty ;
    rdfs:subPropertyOf base:SemanticBridgeReferenceType .

sb:hasDataType a owl:ObjectProperty .

[] a owl:AllDisjointClasses ;
    owl:members ( opcua:ValueRank_Scalar opcua:ValueRank_OneDimension opcua:ValueRank_MoreDimensions ) .

