@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal synthetic Semantic Bridge fixture reproducing the owl_to_virtualtypes.md
# examples: plain inheritance (§9), depth-1 override (§10, BaseType/PumpType Drive),
# nested override reached only through the declared type's own inheritance
# (AdvancedDriveType overriding DriveType's Motor), and 3-level recursion down to a
# Variable declaration with a Datatype (§11, §17, §18).
#
# Shape of the model:
#   BaseType          -- Drive:DriveType (Mandatory)
#     DriveType       -- Motor:MotorType (Mandatory)
#       MotorType     -- Temperature:PropertyType/Double (Optional, scalar)
#   PumpType <: BaseType, overrides Drive:AdvancedDriveType
#     AdvancedDriveType <: DriveType, overrides Motor:AdvancedMotorType
#       AdvancedMotorType <: MotorType (no own definer node -- pure inheritance)
#   AdvancedPumpType <: PumpType (no own definer node -- pure inheritance)

opcua:OPCUANamespace a base:Namespace ;
    base:hasPrefix "opcua" ;
    base:hasUri "http://opcfoundation.org/UA/" .

# --- Reference type / semantic bridge property scaffolding -----------------

opcua:HasChild a owl:ObjectProperty .
opcua:Aggregates a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:HasChild .
opcua:HasComponent a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:Aggregates .
opcua:HasProperty a owl:ObjectProperty ;
    rdfs:subPropertyOf opcua:Aggregates .

opcua:hasDrive a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .
opcua:hasMotor a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .
opcua:hasTemperature a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .

# --- ModellingRule individuals ----------------------------------------------

opcua:nodei78 a uardf:Object ;
    uardf:name "Mandatory" ;
    uardf:browseName "Mandatory" ;
    uardf:nodeId "i=78" ;
    uardf:symbolicName "ModellingRule_Mandatory" .

opcua:nodei80 a uardf:Object ;
    uardf:name "Optional" ;
    uardf:browseName "Optional" ;
    uardf:nodeId "i=80" ;
    uardf:symbolicName "ModellingRule_Optional" .

# --- Class layer -------------------------------------------------------------

opcua:BaseDataType a owl:Class .
opcua:Double a owl:Class ;
    rdfs:subClassOf opcua:BaseDataType .
opcua:String a owl:Class ;
    rdfs:subClassOf opcua:BaseDataType .

opcua:BaseObjectType a owl:Class .
opcua:BaseVariableType a owl:Class .
opcua:PropertyType a owl:Class ;
    rdfs:subClassOf opcua:BaseVariableType .

opcua:DriveType a owl:Class ;
    rdfs:subClassOf opcua:BaseObjectType .
opcua:AdvancedDriveType a owl:Class ;
    rdfs:subClassOf opcua:DriveType .

opcua:MotorType a owl:Class ;
    rdfs:subClassOf opcua:BaseObjectType .
opcua:AdvancedMotorType a owl:Class ;
    rdfs:subClassOf opcua:MotorType .

opcua:BaseType a owl:Class ;
    rdfs:subClassOf opcua:BaseObjectType .
opcua:PumpType a owl:Class ;
    rdfs:subClassOf opcua:BaseType .
opcua:AdvancedPumpType a owl:Class ;
    rdfs:subClassOf opcua:PumpType .

# --- Declaration layer ---------------------------------------------------
# BaseType: Drive : DriveType (Mandatory)

opcua:nodei1001 a uardf:ObjectType ;
    opcua:HasComponent opcua:nodei1002 ;
    opcua:hasDrive opcua:nodei1002 ;
    uardf:definesType opcua:BaseType ;
    uardf:name "BaseType" ;
    uardf:browseName "BaseType" ;
    uardf:nodeId "i=1001" .

opcua:nodei1002 a uardf:Object ;
    opcua:HasModellingRule opcua:nodei78 ;
    uardf:hasTypeDefinition opcua:DriveType ;
    uardf:name "Drive" ;
    uardf:browseName "Drive" ;
    uardf:nodeId "i=1002" .

# DriveType: Motor : MotorType (Mandatory)

opcua:nodei1003 a uardf:ObjectType ;
    opcua:HasComponent opcua:nodei1004 ;
    opcua:hasMotor opcua:nodei1004 ;
    uardf:definesType opcua:DriveType ;
    uardf:name "DriveType" ;
    uardf:browseName "DriveType" ;
    uardf:nodeId "i=1003" .

opcua:nodei1004 a uardf:Object ;
    opcua:HasModellingRule opcua:nodei78 ;
    uardf:hasTypeDefinition opcua:MotorType ;
    uardf:name "Motor" ;
    uardf:browseName "Motor" ;
    uardf:nodeId "i=1004" .

# MotorType: Temperature : PropertyType / Double (Optional, scalar by omission)

opcua:nodei1005 a uardf:ObjectType ;
    opcua:HasProperty opcua:nodei1006 ;
    opcua:hasTemperature opcua:nodei1006 ;
    uardf:definesType opcua:MotorType ;
    uardf:name "MotorType" ;
    uardf:browseName "MotorType" ;
    uardf:nodeId "i=1005" .

opcua:nodei1006 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    opcua:HasModellingRule opcua:nodei80 ;
    base:hasDatatype opcua:Double ;
    uardf:name "Temperature" ;
    uardf:browseName "Temperature" ;
    uardf:nodeId "i=1006" .

# AdvancedDriveType: overrides Motor : AdvancedMotorType (Mandatory)

opcua:nodei1007 a uardf:ObjectType ;
    opcua:HasComponent opcua:nodei1008 ;
    opcua:hasMotor opcua:nodei1008 ;
    uardf:definesType opcua:AdvancedDriveType ;
    uardf:name "AdvancedDriveType" ;
    uardf:browseName "AdvancedDriveType" ;
    uardf:nodeId "i=1007" .

opcua:nodei1008 a uardf:Object ;
    opcua:HasModellingRule opcua:nodei78 ;
    uardf:hasTypeDefinition opcua:AdvancedMotorType ;
    uardf:name "Motor" ;
    uardf:browseName "Motor" ;
    uardf:nodeId "i=1008" .

# PumpType: overrides Drive : AdvancedDriveType (Mandatory)

opcua:nodei1009 a uardf:ObjectType ;
    opcua:HasComponent opcua:nodei1010 ;
    opcua:hasDrive opcua:nodei1010 ;
    uardf:definesType opcua:PumpType ;
    uardf:name "PumpType" ;
    uardf:browseName "PumpType" ;
    uardf:nodeId "i=1009" .

opcua:nodei1010 a uardf:Object ;
    opcua:HasModellingRule opcua:nodei78 ;
    uardf:hasTypeDefinition opcua:AdvancedDriveType ;
    uardf:name "Drive" ;
    uardf:browseName "Drive" ;
    uardf:nodeId "i=1010" .

# AdvancedMotorType and AdvancedPumpType have no own definer node: pure inheritance,
# no local override -- exercises the "class with no own declarations" edge case.

# --- Self-referential type (regression case) --------------------------------
# Mirrors a real pattern found in the actual OPC UA core nodeset: DictionaryEntryType
# declares an OptionalPlaceholder child "<DictionaryEntryName>" typed as
# DictionaryEntryType itself (an arbitrarily nested dictionary/tree of entries).
# The "Entry" declaration also has its own local extra child "Label" (beyond
# what DictionaryEntryType itself provides), which forces a Virtual Type to be
# minted here (a plain self-reference with no local extension needs no VT at
# all under the need-based design -- it just targets DictionaryEntryType
# directly). Minting that VT recurses into get_cdt(DictionaryEntryType) while
# that same call is still on the stack computing "Entry" itself -- exactly
# the cycle the `_cdt_computing` guard in get_cdt exists to break.

opcua:nodei11508 a uardf:Object ;
    uardf:name "OptionalPlaceholder" ;
    uardf:browseName "OptionalPlaceholder" ;
    uardf:nodeId "i=11508" ;
    uardf:symbolicName "ModellingRule_OptionalPlaceholder" .

opcua:hasEntry a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .
opcua:hasLabel a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .
opcua:hasRevision a owl:ObjectProperty ;
    rdfs:subPropertyOf uardf:semanticBridgeReferenceType .

opcua:DictionaryEntryType a owl:Class ;
    rdfs:subClassOf opcua:BaseObjectType .

# nodei2001 also directly aggregates "Revision" (nodei2005) with NO
# opcua:HasModellingRule triple at all -- mirroring the real core.ttl
# pattern of named States/Transitions inside a StateMachineType-derived
# type (e.g. ExclusiveLimitStateMachineType's "High"/"HighToHighHigh"):
# not optional-or-mandatory in the usual sense, always present, more like
# a fixed enum member, yet still a real declaration that count_own_
# instance_declarations(include_unruled=True) must count and that
# get_cdt/_merge_local still processes and can still mint a Virtual Type
# for regardless of ModellingRule presence.
opcua:nodei2001 a uardf:ObjectType ;
    opcua:HasComponent opcua:nodei2002 ;
    opcua:hasEntry opcua:nodei2002 ;
    opcua:HasProperty opcua:nodei2005 ;
    opcua:hasRevision opcua:nodei2005 ;
    uardf:definesType opcua:DictionaryEntryType ;
    uardf:name "DictionaryEntryType" ;
    uardf:browseName "DictionaryEntryType" ;
    uardf:nodeId "i=2001" .

opcua:nodei2005 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    base:hasDatatype opcua:Int32 ;
    uardf:name "Revision" ;
    uardf:browseName "Revision" ;
    uardf:nodeId "i=2005" .

opcua:nodei2002 a uardf:Object ;
    opcua:HasModellingRule opcua:nodei11508 ;
    opcua:HasProperty opcua:nodei2003 ;
    opcua:hasLabel opcua:nodei2003 ;
    uardf:hasTypeDefinition opcua:DictionaryEntryType ;
    uardf:name "Entry" ;
    uardf:browseName "Entry" ;
    uardf:nodeId "i=2002" .

opcua:nodei2003 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    opcua:HasModellingRule opcua:nodei80 ;
    base:hasDatatype opcua:String ;
    uardf:name "Label" ;
    uardf:browseName "Label" ;
    uardf:nodeId "i=2003" .

# Subclass with no own definer node (pure inheritance), mirroring the real
# core.ttl case (IrdiDictionaryEntryType etc.) that first exposed the dangling
# forward-reference bug: scanning THIS type as root reaches DictionaryEntryType's
# own two-level self-reference one step further than DictionaryEntryType's own
# root-scan ever does, so DictionaryEntryType's deeper VT must still get typed.
opcua:SpecialDictionaryEntryType a owl:Class ;
    rdfs:subClassOf opcua:DictionaryEntryType .
