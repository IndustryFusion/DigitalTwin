@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

opcua: a owl:Ontology ;
    owl:imports <https://industryfusion.github.io/contexts/staging/ontology/v0.1/base.ttl> ;
    owl:versionInfo 1e-01 .


# Not OK, i=1 is not a DataValue (since not target of hascomponent) (3)
opcua:aT0x a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations1" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations1"@en ;
    uardf:nodeId "i=1" ;
    base:hasValueRank -2 .

opcua:aT0y a uardf:Variable ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Annotations2" ;
    opcua:HasComponent opcua:aT0x ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations2"@en ;
    uardf:nodeId "i=2" ;
    base:hasValueRank -2 .


# OK
opcua:aT0z a uardf:Variable ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Annotations3" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations3"@en ;
    uardf:nodeId "i=3" ;
    base:hasValueRank -2 .

opcua:aT00 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Annotations4" ;
    opcua:HasComponent opcua:aT0z ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations4"@en ;
    uardf:nodeId "i=4" ;
    base:hasValueRank -2 .

opcua:aT01 a uardf:Object ;
    uardf:hasTypeDefinition opcua:MyObjectType ;
    uardf:name "Annotations5" ;
    opcua:HasComponent opcua:aT00 ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations5"@en ;
    uardf:nodeId "i=5" ;
    base:hasValueRank -2 .

# Target of HasComponent is neither Object, Variable or Method (1)
opcua:aT02 a uardf:VariableType ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Annotations6" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations6"@en ;
    uardf:nodeId "i=6" ;
    base:hasValueRank -2 .

opcua:aT03 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:BaseDataVariableType ;
    uardf:name "Annotations7" ;
    opcua:HasComponent opcua:aT02 ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations7"@en ;
    uardf:nodeId "i=7" ;
    base:hasValueRank -2 .