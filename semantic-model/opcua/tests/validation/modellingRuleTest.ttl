@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

opcua: a owl:Ontology ;
    owl:versionInfo 1e-01 .


# Not OK: two ModellingRules on one node violates sh:maxCount 1.
opcua:aT0x a uardf:Variable ;
    uardf:name "TwoRules" ;
    opcua:HasModellingRule opcua:aT03OA, opcua:aT04MA .

# Not OK: i=9999 is not one of the five real ModellingRules (sh:in).
opcua:aT0y a uardf:Variable ;
    uardf:name "BogusRule" ;
    opcua:HasModellingRule opcua:aT05OTk5 .

# Not OK: a ReferenceType may not carry a ModellingRule at all. Exactly one
# legal rule, so sh:in and sh:maxCount stay silent and only the SPARQL
# constraint can report this node.
opcua:aT0z a uardf:ReferenceType ;
    uardf:name "ReferenceTypeWithRule" ;
    opcua:HasModellingRule opcua:aT03OA .

# Not OK: same for a DataType.
opcua:aT00 a uardf:DataType ;
    uardf:name "DataTypeWithRule" ;
    opcua:HasModellingRule opcua:aT04MA .

# OK: Object, Variable and Method are the three node classes that may carry a
# ModellingRule. None of these may be reported.
opcua:aT01 a uardf:Object ;
    uardf:name "MandatoryObject" ;
    opcua:HasModellingRule opcua:aT03OA .

opcua:aT02 a uardf:Variable ;
    uardf:name "OptionalVariable" ;
    opcua:HasModellingRule opcua:aT04MA .

opcua:aT03 a uardf:Method ;
    uardf:name "MandatoryMethod" ;
    opcua:HasModellingRule opcua:aT03OA .

# OK: ExposesItsArray, OptionalPlaceholder and MandatoryPlaceholder are the
# remaining three legal values of sh:in.
opcua:aT04 a uardf:Variable ;
    uardf:name "ExposesItsArray" ;
    opcua:HasModellingRule opcua:aT04Mw .

opcua:aT05 a uardf:Object ;
    uardf:name "OptionalPlaceholder" ;
    opcua:HasModellingRule opcua:aT0xMTUwOA .

opcua:aT0xMA a uardf:Object ;
    uardf:name "MandatoryPlaceholder" ;
    opcua:HasModellingRule opcua:aT0xMTUxMA .

# OK: carrying no ModellingRule at all is always fine.
opcua:aT0xMQ a uardf:ReferenceType ;
    uardf:name "PlainReferenceType" .
