@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix uardf: <http://opcfoundation.org/rdf/uacore#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# OK
opcua:aT0x a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations1" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations1"@en ;
    uardf:nodeId "i=1" ;
    base:hasValueRank -2 .

# OK
opcua:aT0y a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations2" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations2"@en ;
    uardf:nodeId "i=2" ;
    base:hasValueRank -1 .

# OK
opcua:aT0z a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations3" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations3"@en ;
    uardf:nodeId "i=3" ;
    base:hasValueRank -3 .

# not allowed Rank Value
opcua:aT00 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations4" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations4"@en ;
    uardf:nodeId "i=4" ;
    base:hasValueRank -4 .

# OK - ValueRank -2 (Any) permits "a scalar or an array with any number of
# dimensions", so no ArrayDimensions length contradicts it.
opcua:aT01 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations5" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations5"@en ;
    uardf:nodeId "i=5" ;
    base:hasArrayDimensions ( 1 ) ;
    base:hasValueRank -2 .

# OK - ValueRank 0 (OneOrMoreDimensions) means the Value IS an array, so it has
# ArrayDimensions; the declaration does not fix how many, so no length is wrong.
opcua:aT02 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations6" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations6"@en ;
    uardf:nodeId "i=6" ;
    base:hasArrayDimensions ( 1 );
    base:hasValueRank 0 .

# OK
opcua:aT03 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
    uardf:name "Annotations7" ;
    base:hasDatatype opcua:Annotation ;
    uardf:displayName "Annotations7"@en ;
    uardf:nodeId "i=7" ;
    base:hasArrayDimensions ( 1 );
    base:hasValueRank 1 .

# OK
opcua:aT04 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations8" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations8"@en ;
uardf:nodeId "i=8" ;
base:hasArrayDimensions ( 2 2 );
base:hasValueRank 2 .

# Not OK, ArrayDimension contains negative number
opcua:aT05 a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations9" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations9"@en ;
uardf:nodeId "i=9" ;
base:hasArrayDimensions ( 2 -2 1 1);
base:hasValueRank 4 .

# OK
opcua:aT0xMA a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations10" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations10"@en ;
uardf:nodeId "i=10" ;
base:hasArrayDimensions ( 0 );
base:hasValueRank 1 .

# ValueRank contradicts type definition
opcua:aT0xMQ a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType ;
uardf:name "Annotations11" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations11"@en ;
uardf:nodeId "i=11" ;
base:hasArrayDimensions ( 0 );
base:hasValueRank 1 .

opcua:aT0xMg a uardf:VariableType ;
uardf:definesType base:MyVariableType;
uardf:name "MyVariableType" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "MyVariableType"@en ;
uardf:nodeId "i=12" ;
base:hasValueRank -1 .

# OK
opcua:aT0xMw a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType ;
uardf:name "Annotations13" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations13"@en ;
uardf:nodeId "i=13" ;
.

# Not OK - missing arrayDimensions
opcua:aT0xNA a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType2 ;
uardf:name "Annotations14" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations14"@en ;
uardf:nodeId "i=14" ;
base:hasValueRank 2 .

opcua:aT0xNQ a uardf:VariableType ;
uardf:definesType base:MyVariableType2;
uardf:name "MyVariableType2" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "MyVariableType2"@en ;
uardf:nodeId "i=15" ;
base:hasValueRank -2 .

# Not okay, valueRank 2 is wrong
opcua:aT0xNg a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType3 ;
uardf:name "Annotations16" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations16"@en ;
uardf:nodeId "i=16" ;
base:hasValueRank 2 .

opcua:aT0xNw a uardf:VariableType ;
uardf:definesType base:MyVariableType3;
uardf:name "MyVariableType3" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "MyVariableType3"@en ;
uardf:nodeId "i=17" ;
base:hasValueRank -3 .

# Not OK - ArrayDimensions missing
opcua:aT0xOA a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType3 ;
uardf:name "Annotations18" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations18"@en ;
uardf:nodeId "i=18" ;
base:hasValueRank 1 .

# Not OK  - supertype does not match subtype
opcua:aT0xOQ a uardf:VariableType ;
uardf:definesType base:MyVariableType4;
uardf:name "MyVariableType19" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "MyVariableType19"@en ;
uardf:nodeId "i=19" ;
base:hasValueRank -1 .

opcua:aT0yMA a uardf:VariableType ;
uardf:definesType base:MyVariableType5;
uardf:name "MyVariableType20" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "MyVariableType20"@en ;
uardf:nodeId "i=20" ;
base:hasValueRank 0 .

base:MyVariableType4 a owl:Class ;
    rdfs:subClassOf base:MyVariableType5 .


opcua:MyVariableType5 a owl:Class .

# Not ok - ValueRank and ArrayDefinitions do not match
opcua:aT0yMQ a uardf:Variable ;
    uardf:hasTypeDefinition base:MyVariableType3 ;
uardf:name "Annotations21" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations21"@en ;
uardf:nodeId "i=21" ;
base:hasArrayDimensions ( 0 1 );
base:hasValueRank 1 .

# OK - ValueRank -3 (ScalarOrOneDimension) with a single ArrayDimensions entry.
# This is the exact shape of OPC UA DI's WarningValues (ns=1;i=472), which is
# compliant: Part 3 5.6.2 lets the Value of a -3 Variable be a one-dimensional
# array, and one element of 0 means "maximum length unknown". Must NOT be flagged.
opcua:aT0yMg a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations22" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations22"@en ;
uardf:nodeId "i=22" ;
base:hasArrayDimensions ( 0 );
base:hasValueRank -3 .

# Not OK - ValueRank -3 permits at most ONE dimension, so two is still a violation.
opcua:aT0yMw a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations23" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations23"@en ;
uardf:nodeId "i=23" ;
base:hasArrayDimensions ( 0 2 );
base:hasValueRank -3 .

# Not OK - ValueRank -1 is Scalar, "The value is not an array", so ArrayDimensions
# shall be null. This is the one rank below 1 that does constrain the length, and
# it is what keeps the relaxations for -2/0/-3 from emptying the rule.
opcua:aT0yNA a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations24" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations24"@en ;
uardf:nodeId "i=24" ;
base:hasArrayDimensions ( 1 );
base:hasValueRank -1 .

# OK - ValueRank -2 with a multi-dimensional ArrayDimensions: "any number of
# dimensions" includes this one.
opcua:aT0yNQ a uardf:Variable ;
    uardf:hasTypeDefinition opcua:PropertyType ;
uardf:name "Annotations25" ;
base:hasDatatype opcua:Annotation ;
uardf:displayName "Annotations25"@en ;
uardf:nodeId "i=25" ;
base:hasArrayDimensions ( 2 2 );
base:hasValueRank -2 .