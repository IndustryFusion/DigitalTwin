@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shacl: <http://my.test/shacl/> .
@prefix test: <http://my.test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw> ;
                    sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw>->test:hasStatus" ;
                    sh:resultPath test:hasStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:BlankNode ;
                            sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:Literal ;
                                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:or ( [ ] [ ] ) ;
                                                sh:path ngsi-ld:hasValueList ] ] ) ;
                            sh:path test:hasStatus ;
                            base:hasReferenceType opcua:HasComponent ] ] ;
            sh:focusNode [ a ngsi-ld:Relationship ;
                    ngsi-ld:hasObject <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw> ] ;
            sh:resultMessage "Value does not conform to Shape shacl:AlphaType_LinkDeclarationShape. See details for more information." ;
            sh:resultPath ngsi-ld:hasObject ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class opcua:BaseObjectType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node shacl:AlphaType_LinkDeclarationShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            sh:value <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw> ] .

