@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix test: <http://my.test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAyMA> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAyMA>->test:hasTc" ;
            sh:resultPath test:hasTc ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ a base:SubComponentRelationship ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:path test:hasTc ;
                    sh:property [ sh:class test:TType ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path ngsi-ld:hasObject ] ;
                    base:hasReferenceType opcua:HasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjA0MA> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjA0MA>->test:hasNeed" ;
            sh:resultPath test:hasNeed ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:nodeKind sh:Literal ;
                                        sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:or ( [ ] [ ] ) ;
                                        sh:path ngsi-ld:hasValueList ] ] ) ;
                    sh:path test:hasNeed ;
                    base:hasReferenceType opcua:HasComponent ] ] .

