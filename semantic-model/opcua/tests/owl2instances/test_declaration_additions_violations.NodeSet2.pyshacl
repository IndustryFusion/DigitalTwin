@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shacl: <http://my.test/shacl/> .
@prefix test: <http://my.test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg> ;
                    sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg>->test:hasLevel" ;
                    sh:resultPath test:hasLevel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:BlankNode ;
                            sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:nodeKind sh:Literal ;
                                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:or ( [ ] [ ] ) ;
                                                sh:path ngsi-ld:hasValueList ] ] ) ;
                            sh:path test:hasLevel ;
                            base:hasReferenceType opcua:HasComponent ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode [ a ngsi-ld:Relationship ;
                            ngsi-ld:datasetId test:hasItem2 ;
                            ngsi-ld:hasObject <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAxNA> ] ;
                    sh:resultMessage "Value does not have class test:ItemType" ;
                    sh:resultPath ngsi-ld:hasObject ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                    sh:sourceShape [ sh:class test:ItemType ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path ngsi-ld:hasObject ] ;
                    sh:value <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAxNA> ] ;
            sh:focusNode [ a ngsi-ld:Relationship ;
                    ngsi-ld:hasObject <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg> ] ;
            sh:resultMessage "Value does not conform to Shape shacl:AlphaType_LinkDeclarationShape. See details for more information." ;
            sh:resultPath ngsi-ld:hasObject ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class test:LinkType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node shacl:AlphaType_LinkDeclarationShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            sh:value <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNA> ;
                    sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNA>->test:has%3CPart%3E" ;
                    sh:resultPath test:has%3CPart%3E ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ a base:SubComponentRelationship ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:BlankNode ;
                            sh:path test:has%3CPart%3E ;
                            sh:property [ sh:class test:ItemType ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path ngsi-ld:hasObject ] ;
                            base:hasPlaceHolderPattern "[a-zA-Z0-9_-]+" ;
                            base:hasReferenceType opcua:HasComponent ;
                            base:isPlaceHolder true ] ] ;
            sh:focusNode [ a ngsi-ld:Relationship ;
                    ngsi-ld:hasObject <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNA> ] ;
            sh:resultMessage "Value does not conform to Shape shacl:AlphaType_MandDeclarationShape. See details for more information." ;
            sh:resultPath ngsi-ld:hasObject ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class opcua:BaseObjectType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node shacl:AlphaType_MandDeclarationShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            sh:value <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNA> ] .

