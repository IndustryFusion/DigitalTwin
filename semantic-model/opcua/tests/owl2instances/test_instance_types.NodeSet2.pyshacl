@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix test: <http://my.test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMw>->test:hasLevel" ;
            sh:resultPath test:hasLevel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:nodeKind sh:Literal ;
                                        sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:or ( [ ] [ ] ) ;
                                        sh:path ngsi-ld:hasValueList ] ] ) ;
                    sh:path test:hasLevel ;
                    base:hasReferenceType opcua:HasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwMg>->test:hasExtra" ;
            sh:resultPath test:hasExtra ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:nodeKind sh:Literal ;
                                        sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:or ( [ ] [ ] ) ;
                                        sh:path ngsi-ld:hasValueList ] ] ) ;
                    sh:path test:hasExtra ;
                    base:hasReferenceType opcua:HasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNg> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNg>->test:hasRate" ;
            sh:resultPath test:hasRate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:nodeKind sh:Literal ;
                                        sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:or ( [ ] [ ] ) ;
                                        sh:path ngsi-ld:hasValueList ] ] ) ;
                    sh:path test:hasRate ;
                    base:hasReferenceType opcua:HasComponent ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNw> ;
            sh:resultMessage "Less than 1 values on <urn:uaentity:c3Z1PXVybjp0ZXN0OnNlcnZlcjtuc3U9aHR0cDovL215LnRlc3QvO2k9MjAwNw>->test:hasCount" ;
            sh:resultPath test:hasCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:datatype xsd:integer ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:nodeKind sh:Literal ;
                                        sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:or ( [ ] [ ] ) ;
                                        sh:path ngsi-ld:hasValueList ] ] ) ;
                    sh:path test:hasCount ;
                    base:hasReferenceType opcua:HasComponent ] ] .

