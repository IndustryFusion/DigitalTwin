@prefix base: <https://industryfusion.github.io/contexts/ontology/v0/base/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix opcua: <http://opcfoundation.org/UA/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shacl: <http://my.test/shacl/> .
@prefix test: <http://my.test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shacl:AlphaTypeShape a sh:NodeShape ;
    sh:property [ a base:SubComponentRelationship ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:BlankNode ;
            sh:path test:hasMarked ;
            sh:property [ sh:class opcua:BaseObjectType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            base:hasReferenceType opcua:HasComponent ],
        [ a base:SubComponentRelationship ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:path test:hasMand ;
            sh:property [ sh:class opcua:BaseObjectType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node shacl:AlphaType_MandDeclarationShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            base:hasReferenceType opcua:HasComponent ],
        [ a base:SubComponentRelationship ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:path test:hasLink ;
            sh:property [ sh:class test:LinkType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node shacl:AlphaType_LinkDeclarationShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            base:hasReferenceType opcua:HasComponent ] ;
    sh:targetClass test:AlphaType .

shacl:BaseObjectTypeShape a sh:NodeShape ;
    sh:targetClass opcua:BaseObjectType .

shacl:ItemTypeShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:or ( [ sh:property [ sh:datatype xsd:integer ;
                                sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:nodeKind sh:Literal ;
                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:or ( [ sh:nodeKind sh:BlankNode ;
                                            sh:property [ sh:datatype xsd:integer ;
                                                    sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] [ sh:hasValue () ] ) ;
                                sh:path ngsi-ld:hasValueList ] ] ) ;
            sh:path test:hasCode ;
            base:hasReferenceType opcua:HasComponent ] ;
    sh:targetClass test:ItemType .

shacl:LinkTypeShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:nodeKind sh:Literal ;
                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:or ( [ sh:nodeKind sh:BlankNode ;
                                            sh:property [ sh:datatype xsd:boolean ;
                                                    sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] [ sh:hasValue () ] ) ;
                                sh:path ngsi-ld:hasValueList ] ] ) ;
            sh:path test:hasStatus ;
            base:hasReferenceType opcua:HasComponent ] ;
    sh:targetClass test:LinkType .

shacl:AlphaType_LinkDeclarationShape a sh:NodeShape ;
    sh:property [ a base:SubComponentRelationship ;
            sh:minCount 0 ;
            sh:nodeKind sh:BlankNode ;
            sh:path test:hasItem%3Cno%3E ;
            sh:property [ sh:class test:ItemType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            base:hasPlaceHolderPattern "Item[a-zA-Z0-9_-]+" ;
            base:hasReferenceType opcua:HasComponent ;
            base:isPlaceHolder true ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:or ( [ sh:property [ sh:datatype xsd:double ;
                                sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:nodeKind sh:Literal ;
                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:or ( [ sh:nodeKind sh:BlankNode ;
                                            sh:property [ sh:datatype xsd:double ;
                                                    sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] [ sh:hasValue () ] ) ;
                                sh:path ngsi-ld:hasValueList ] ] ) ;
            sh:path test:hasLevel ;
            base:hasReferenceType opcua:HasComponent ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:BlankNode ;
            sh:or ( [ sh:property [ sh:datatype xsd:string ;
                                sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:nodeKind sh:Literal ;
                                sh:path ngsi-ld:hasValue ] ] [ sh:property [ sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:or ( [ sh:nodeKind sh:BlankNode ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] [ sh:hasValue () ] ) ;
                                sh:path ngsi-ld:hasValueList ] ] ) ;
            sh:path test:hasNote ;
            base:hasReferenceType opcua:HasComponent ] .

shacl:AlphaType_MandDeclarationShape a sh:NodeShape ;
    sh:property [ a base:SubComponentRelationship ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:path test:has%3CPart%3E ;
            sh:property [ sh:class test:ItemType ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path ngsi-ld:hasObject ] ;
            base:hasPlaceHolderPattern "[a-zA-Z0-9_-]+" ;
            base:hasReferenceType opcua:HasComponent ;
            base:isPlaceHolder true ] .

