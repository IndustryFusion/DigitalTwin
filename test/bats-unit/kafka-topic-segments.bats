#
# Every KafkaTopic the charts declare rolls its segments at its retention, but
# not more often than hourly: segment.ms = max(retention.ms, 1 h). Kafka deletes only whole segments, and only once the newest record in a
# segment is older than retention.ms. A topic that is written to keeps its open
# segment until segment.ms, which defaults to 7 days, so a topic with a 1 h
# retention held days of records. Rolling a 10 s topic at 10 s, though, deletes
# records a restarted consumer or a test still reads back. The topics generated by shacl2flink are
# checked by semantic-model/shacl2flink/tests/test_kafka_topic_segments.py.

bats_require_minimum_version 1.5.0

CHARTS="${BATS_TEST_DIRNAME}/../../helm/charts"

setup() {
    WORK="$(mktemp -d)"
    export WORK
}

teardown() {
    rm -rf "${WORK}"
}

@test "every chart KafkaTopic sets segment.ms to max(retention.ms, 1 h)" {
    run python3 - "${CHARTS}" <<'EOF'
import pathlib, re, sys
found = 0
errors = []
for path in sorted(pathlib.Path(sys.argv[1]).glob('*/templates/*.y*ml')):
    for doc in re.split(r'^---', path.read_text(), flags=re.M):
        if not re.search(r'^kind: KafkaTopic\s*$', doc, flags=re.M):
            continue
        found += 1
        name = re.search(r'^  name: (.*)$', doc, flags=re.M).group(1)
        retention = re.findall(r'^    retention\.ms: (.*)$', doc, flags=re.M)
        segment = re.findall(r'^    segment\.ms: (.*)$', doc, flags=re.M)
        expected = [re.sub(r"^'?\{\{\s*(\.Values\.[\w.]+)\s*\}\}'?$", r'{{ max 3600000 (int64 \1) }}', r)
                    for r in retention]
        if retention == [] or segment != expected:
            errors.append(f'{path.name} {name}: retention.ms {retention} segment.ms {segment}')
assert found >= 16, f'only {found} KafkaTopic resources found'
assert not errors, '\n'.join(errors)
EOF
    echo "${output}"
    [ "${status}" -eq 0 ]
}

@test "rendered chart topics have segment.ms = max(retention.ms, 1 h), for strings and numbers" {
    command -v helm >/dev/null || skip "helm is not installed"
    mkdir -p "${WORK}/chart/templates"
    printf 'apiVersion: v2\nname: topics\nversion: 0.1.0\n' > "${WORK}/chart/Chart.yaml"
    cp "${CHARTS}/sql-core/templates/core-kafka-topics.yaml" \
       "${CHARTS}/kafka-bridges/templates/bridge-topics.yaml" \
       "${CHARTS}/scorpio/templates/scorpio-aaio-topics.yaml" "${WORK}/chart/templates/"
    # The value types of helm/values.yaml.gotmpl (quoted strings) and of the
    # scorpio chart (plain numbers), below and above 1 h; every retention
    # differs, so a segment.ms that follows the wrong value shows.
    cat > "${WORK}/values.yaml" <<'EOF'
kafka:
  name: my-cluster
aaio:
  enabled: true
kafkaBridge:
  alerta:
    bulkTopic: iff.alerts.bulk
    bulkTopicRetention: "10000"
    listenTopic: iff.alerts
    listenTopicRetention: "3600001"
  ngsildUpdates:
    listenTopic: iff.ngsild-updates
    listenTopicRetention: "28800000"
  debezium:
    listenTopic: iff.ngsild.public.entity
    listenTopicRetention: "3600003"
    listenTopicCompression: uncompressed
    attributesTopic: iff.ngsild.attributes
    entitiesTopic: iff.ngsild.entities
    entityTopicRetention: "3600006"
    attributesTopicRetention: "3600004"
    attributesTopicCompression: uncompressed
kafka_topic_vars:
  ENTITY_TOPIC: scorpio.entity
  REGISTRY_TOPIC: scorpio.registry
  TEMPORAL_TOPIC: scorpio.temporal
  INTERNAL_NOTIFY_TOPIC: scorpio.inotify
  INTERNAL_REGISTRYSUB_TOPIC: scorpio.regsub
  SUB_ALIVE_TOPIC: scorpio.sub.alive
  SUB_SYNC_TOPIC: scorpio.sub.sync
  REGISTRYSUB_ALIVE_TOPIC: scorpio.regsub.alive
  REGISTRYSUB_SYNC_TOPIC: scorpio.regsub.sync
  retention: 3600005
EOF
    check() {
        python3 - "$1" "$2" <<'EOF'
import sys, yaml
topics = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d and d['kind'] == 'KafkaTopic']
assert len(topics) == 16, len(topics)
for t in topics:
    config = t['spec']['config']
    retention, segment = int(config['retention.ms']), int(config['segment.ms'])
    assert segment == max(retention, 3600000), (t['metadata']['name'], segment, retention)
segments = {t['metadata']['name']: int(t['spec']['config']['segment.ms']) for t in topics}
assert segments['iff.alerts.bulk'] == 3600000, segments
assert segments['iff.ngsild-updates'] == 28800000, segments
assert segments['scorpio.entity'] == int(sys.argv[2]), segments
EOF
    }
    run helm template t "${WORK}/chart" -f "${WORK}/values.yaml"
    [ "${status}" -eq 0 ]
    echo "${output}" > "${WORK}/rendered.yaml"
    run check "${WORK}/rendered.yaml" 3600005
    echo "${output}"
    [ "${status}" -eq 0 ]

    # a number below 1 h
    run helm template t "${WORK}/chart" -f "${WORK}/values.yaml" --set kafka_topic_vars.retention=10000
    [ "${status}" -eq 0 ]
    echo "${output}" > "${WORK}/rendered.yaml"
    run check "${WORK}/rendered.yaml" 3600000
    echo "${output}"
    [ "${status}" -eq 0 ]
}
